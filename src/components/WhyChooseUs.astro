---
const features = [
  {
    icon: '<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0z" />',
    title: 'Honest Treatment',
    description: 'We never recommend unnecessary procedures. Only what you truly need for a healthy smile.',
  },
  {
    icon: '<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9.663 17h4.673M12 3v1m6.364 1.636l-.707.707M21 12h-1M4 12H3m3.343-5.657l-.707-.707m2.828 9.9a5 5 0 117.072 0l-.548.547A3.374 3.374 0 0014 18.469V19a2 2 0 11-4 0v-.531c0-.895-.356-1.754-.988-2.386l-.548-.547z" />',
    title: 'Advanced Technology',
    description: 'State-of-the-art equipment for precise diagnostics and comfortable, efficient treatment.',
  },
  {
    icon: '<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 14l9-5-9-5-9 5 9 5z" /><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 14l6.16-3.422a12.083 12.083 0 01.665 6.479A11.952 11.952 0 0012 20.055a11.952 11.952 0 00-6.824-2.998 12.078 12.078 0 01.665-6.479L12 14z" />',
    title: 'Continuing Education',
    description: 'All doctors and staff maintain current certifications in the latest dental techniques.',
  },
  {
    icon: '<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z" />',
    title: 'Gentle Approach',
    description: 'Every patient is treated with respect, compassion, and a commitment to minimal-impact care.',
  },
];
---

<section class="py-20 lg:py-28 bg-white" aria-labelledby="why-heading">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="text-center max-w-3xl mx-auto mb-16">
      <p class="text-sm font-semibold text-primary uppercase tracking-wider mb-3">Why Choose Premier Dental</p>
      <h2 id="why-heading" class="font-heading text-3xl sm:text-4xl lg:text-5xl font-bold text-text">
        Patient-First Dental Care in Albemarle & Charlotte
      </h2>
    </div>

    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-8">
      {features.map((feature) => (
        <div class="text-center p-6 rounded-2xl bg-bg hover:bg-bg-alt transition-colors">
          <div class="w-14 h-14 bg-primary/10 rounded-2xl flex items-center justify-center mx-auto mb-5">
            <svg class="w-7 h-7 text-primary" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <Fragment set:html={feature.icon} />
            </svg>
          </div>
          <h3 class="font-heading text-xl font-semibold text-text mb-2">{feature.title}</h3>
          <p class="text-sm text-text-light leading-relaxed">{feature.description}</p>
        </div>
      ))}
    </div>
  </div>
</section>
