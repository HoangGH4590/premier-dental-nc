---
const faqs = [
  {
    question: 'Do you accept new patients?',
    answer: 'Yes! Premier Dental is always accepting new patients at both our Albemarle and Charlotte locations. We welcome patients of all ages and offer same-week appointment availability for most procedures. <a href="/#contact" class="text-primary hover:underline font-medium">Request your first appointment</a>.',
  },
  {
    question: 'What insurance plans do you accept?',
    answer: 'We accept most major insurance plans including Cigna, Aetna, MetLife, Delta Dental, Guardian, United Healthcare, and Blue Cross Blue Shield. Out-of-pocket costs vary by procedure. <a href="/#insurance" class="text-primary hover:underline font-medium">View our full insurance details</a> or contact us if you don\'t see your plan listed — we\'re happy to help you understand your coverage.',
  },
  {
    question: 'Do you offer same-day emergency dental care?',
    answer: 'Yes. We provide <a href="/services/emergency-dentistry" class="text-primary hover:underline font-medium">same-day emergency dental services</a> at both our Albemarle and Charlotte offices. If you\'re experiencing a dental emergency — severe pain, a broken tooth, swelling, or trauma — call us immediately and we\'ll get you in as quickly as possible.',
  },
  {
    question: 'How often should I get a dental cleaning?',
    answer: 'We recommend dental cleanings and checkups every 6 months for most patients. Regular <a href="/services/preventive-dentistry" class="text-primary hover:underline font-medium">preventive care</a> helps catch problems early, keeps your teeth and gums healthy, and can save you from more costly procedures down the road.',
  },
  {
    question: 'What is EMFACE and do you offer it?',
    answer: '<a href="/#emface" class="text-primary hover:underline font-medium">EMFACE</a> is a non-invasive facial rejuvenation treatment that uses synchronized radiofrequency and HIFES muscle stimulation to lift, tone, and smooth the skin. It also helps relieve TMJ-related facial tension and jaw pain. Yes — we offer EMFACE at both our Albemarle and Charlotte locations, and all our staff are trained and certified.',
  },
  {
    question: 'How much do dental implants cost?',
    answer: 'The cost of <a href="/services/implant-dentistry" class="text-primary hover:underline font-medium">dental implants</a> varies depending on the number of implants needed, whether bone grafting is required, and your insurance coverage. We provide personalized treatment plans with transparent pricing during your consultation. <a href="/#contact" class="text-primary hover:underline font-medium">Schedule a free implant consultation</a>.',
  },
  {
    question: 'What are your office hours?',
    answer: 'Both our <a href="/#locations" class="text-primary hover:underline font-medium">Albemarle and Charlotte offices</a> are open Monday through Thursday, 8:30 AM to 5:00 PM. We are closed Friday, Saturday, and Sunday. We offer flexible scheduling and same-week appointments for most procedures.',
  },
  {
    question: 'Do you offer Invisalign clear aligners?',
    answer: 'Yes! We offer <a href="/services/invisalign" class="text-primary hover:underline font-medium">Invisalign clear aligners</a> as a discreet, comfortable alternative to traditional braces. Invisalign can correct a wide range of alignment issues including crowding, spacing, overbite, and underbite. <a href="/#contact" class="text-primary hover:underline font-medium">Schedule a consultation</a> to find out if Invisalign is right for you.',
  },
];
---

<section id="faq" class="py-20 lg:py-28 bg-bg-alt" aria-labelledby="faq-heading">
  <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="text-center mb-12">
      <p class="text-sm font-semibold text-primary uppercase tracking-wider mb-3">Frequently Asked Questions</p>
      <h2 id="faq-heading" class="font-heading text-3xl sm:text-4xl lg:text-5xl font-bold text-text">
        Common Questions About Our Dental Care
      </h2>
      <p class="mt-4 text-lg text-text-light">
        Find answers to the most common questions about our services, insurance, appointments, and more.
      </p>
    </div>

    <div class="space-y-3">
      {faqs.map((faq, index) => (
        <details class="group bg-white rounded-xl border border-border overflow-hidden hover:border-primary/30 transition-colors">
          <summary class="flex items-center justify-between cursor-pointer px-6 py-5 text-left">
            <span class="font-medium text-text pr-4">{faq.question}</span>
            <svg class="w-5 h-5 text-text-muted shrink-0 transition-transform group-open:rotate-180" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
            </svg>
          </summary>
          <div class="px-6 pb-5 text-text-light leading-relaxed" set:html={faq.answer}>
          </div>
        </details>
      ))}
    </div>

    <div class="text-center mt-10">
      <p class="text-text-light mb-6">Still have questions? We're happy to help. Reach out anytime.</p>
      <div class="inline-flex flex-col sm:flex-row gap-3">
        <a href="tel:7049825516" class="inline-flex items-center gap-2.5 bg-white rounded-full px-6 py-3 text-text font-medium shadow-sm hover:shadow-md transition-shadow">
          <svg class="w-4 h-4 text-primary shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" /></svg>
          Albemarle (704) 982-5516
        </a>
        <a href="tel:7046887120" class="inline-flex items-center gap-2.5 bg-white rounded-full px-6 py-3 text-text font-medium shadow-sm hover:shadow-md transition-shadow">
          <svg class="w-4 h-4 text-primary shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" /></svg>
          Charlotte (704) 688-7120
        </a>
      </div>
      <div class="mt-5">
        <a href="#contact" class="inline-flex items-center justify-center px-6 py-3 bg-primary text-white font-semibold rounded-full hover:bg-primary-dark transition-colors shadow-lg shadow-primary/20">
          Contact Us
        </a>
      </div>
    </div>
  </div>
</section>
