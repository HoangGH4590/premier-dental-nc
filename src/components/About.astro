<section id="about" class="py-20 lg:py-28 bg-bg-alt" aria-labelledby="about-heading">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="grid lg:grid-cols-2 gap-12 lg:gap-16 items-center">
      <!-- Content -->
      <div>
        <p class="text-sm font-semibold text-primary uppercase tracking-wider mb-3">About Premier Dental</p>
        <h2 id="about-heading" class="font-heading text-3xl sm:text-4xl lg:text-5xl font-bold text-text">
          Gentle, Honest Dental Care in NC Since 2012
        </h2>
        <p class="mt-6 text-text-light leading-relaxed">
          We care deeply about our patients and what we do to help them maintain dental health for a lifetime. Our team stays on the cutting edge of dentistry through continuing education and the latest treatment modalities, materials, sterilization techniques, and technology.
        </p>
        <p class="mt-4 text-text-light leading-relaxed">
          Our mission is to make a difference in patients' overall health and appearance. We never provide unnecessary or unwanted treatment — our doctor combines extensive experience with advanced technology, always protecting your teeth with minimal impact.
        </p>

        <div class="mt-10 grid grid-cols-2 gap-6">
          {[
            { title: 'No Unnecessary Treatment', desc: 'We only recommend what you truly need.' },
            { title: 'Advanced Technology', desc: 'Cutting-edge tools for precise, comfortable care.' },
            { title: 'Continuing Education', desc: 'All doctors and staff maintain current certifications.' },
            { title: 'Lifetime Relationships', desc: "Patients stay with us for years — that's our standard." },
          ].map((item) => (
            <div>
              <h3 class="font-heading text-base font-semibold text-text mb-1">{item.title}</h3>
              <p class="text-sm text-text-light">{item.desc}</p>
            </div>
          ))}
        </div>
      </div>

      <!-- Image -->
      <div class="relative">
        <div class="rounded-2xl overflow-hidden shadow-2xl">
          <img
            src="https://cdn.sintra.ai/img/Wgs0VQL2_F3vsBV90CRvTkQ-CuMtLURO1nYkTXdjkds/g:ce/rs:fill:0:0:0/czM6Ly9zaW50cmEtYnJhaW5haS1tZWRpYS9iYzE0NjU2OS04MDdiLTQ1YTYtYjgxNi1lNTkxMTU4MzRkNDEvZmI0ZjIyMmYtNzUzNS00OTc0LTllNzgtZjJjMjA5Mzk0N2E0LTEyMy0xLnBuZw.jpg"
            alt="Premier Dental doctors and team in Albemarle NC"
            width="600"
            height="500"
            class="w-full h-auto object-cover"
            loading="lazy"
          />
        </div>
        <!-- Years Badge -->
        <div class="absolute -bottom-6 -right-6 bg-primary text-white rounded-2xl shadow-xl p-6 text-center">
          <p class="text-4xl font-bold font-heading">14+</p>
          <p class="text-sm mt-1 text-white/80">Years Serving NC</p>
        </div>
      </div>
    </div>
  </div>
</section>
