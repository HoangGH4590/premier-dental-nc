---
const locations = [
  {
    name: 'Albemarle Office',
    badge: 'Albemarle',
    address: '1122 North 6th St',
    city: 'Albemarle, NC 28001',
    phone: '(704) 982-5516',
    phoneTel: '7049825516',
    hours: 'Mon-Thu: 8:30 AM - 5:00 PM',
    closed: 'Fri-Sun: Closed',
    mapUrl: 'https://www.google.com/maps/dir/?api=1&destination=1122+North+6th+St+Albemarle+NC+28001',
    embedUrl: 'https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d3256.123!2d-80.201!3d35.355!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x0%3A0x0!2s1122+North+6th+St+Albemarle+NC+28001!5e0!3m2!1sen!2sus!4v1',
  },
  {
    name: 'Charlotte Office',
    badge: 'Charlotte',
    address: '2100 N Davidson Street',
    city: 'Charlotte, NC 28205',
    phone: '(704) 688-7120',
    phoneTel: '7046887120',
    hours: 'Mon-Thu: 8:30 AM - 5:00 PM',
    closed: 'Fri-Sun: Closed',
    mapUrl: 'https://www.google.com/maps/dir/?api=1&destination=2100+N+Davidson+Street+Charlotte+NC+28205',
    embedUrl: 'https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d3259.123!2d-80.821!3d35.245!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x0%3A0x0!2s2100+N+Davidson+Street+Charlotte+NC+28205!5e0!3m2!1sen!2sus!4v1',
  },
];
---

<section id="locations" class="py-20 lg:py-28 bg-white" aria-labelledby="locations-heading">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="text-center max-w-3xl mx-auto mb-16">
      <p class="text-sm font-semibold text-primary uppercase tracking-wider mb-3">Visit Us</p>
      <h2 id="locations-heading" class="font-heading text-3xl sm:text-4xl lg:text-5xl font-bold text-text">
        Two Convenient Locations
      </h2>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
      {locations.map((loc) => (
        <div class="bg-bg rounded-2xl border border-border overflow-hidden hover:border-primary/30 hover:shadow-lg transition-all">
          <!-- Map placeholder -->
          <div class="h-48 bg-bg-alt flex items-center justify-center">
            <iframe
              src={loc.embedUrl}
              width="100%"
              height="100%"
              style="border:0;"
              allowfullscreen=""
              loading="lazy"
              referrerpolicy="no-referrer-when-downgrade"
              title={`Map of ${loc.name}`}
              class="w-full h-full"
            ></iframe>
          </div>
          <div class="p-6">
            <span class="inline-flex items-center gap-1.5 text-xs font-semibold text-primary uppercase tracking-wider mb-3">
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" /><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" /></svg>
              {loc.badge}
            </span>
            <h3 class="font-heading text-xl font-semibold text-text mb-3">{loc.name}</h3>
            <address class="not-italic text-text-light space-y-1 text-sm">
              <p>{loc.address}</p>
              <p>{loc.city}</p>
            </address>
            <a href={`tel:${loc.phoneTel}`} class="block mt-3 text-primary font-semibold hover:underline">
              {loc.phone}
            </a>
            <div class="mt-3 text-sm text-text-muted">
              <p>{loc.hours}</p>
              <p>{loc.closed}</p>
            </div>
            <a
              href={loc.mapUrl}
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center gap-1.5 mt-4 text-sm font-semibold text-primary hover:underline"
            >
              Get Directions
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"/></svg>
            </a>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>
