---
const cases = [
  { id: 1, src: 'https://premierdentalnc.com/wp-content/uploads/2024/08/1-800x1073.png.webp', alt: 'Before and after dental transformation case 1 — cosmetic dentistry results' },
  { id: 2, src: 'https://premierdentalnc.com/wp-content/uploads/2024/08/2-800x1073.png.webp', alt: 'Before and after dental transformation case 2 — smile makeover' },
  { id: 3, src: 'https://premierdentalnc.com/wp-content/uploads/2024/08/3-800x1073.png.webp', alt: 'Before and after dental transformation case 3 — restorative dentistry' },
  { id: 4, src: 'https://premierdentalnc.com/wp-content/uploads/2024/08/4-800x1073.png.webp', alt: 'Before and after dental transformation case 4 — dental crowns and veneers' },
  { id: 5, src: 'https://premierdentalnc.com/wp-content/uploads/2024/08/5-800x1073.png.webp', alt: 'Before and after dental transformation case 5 — teeth restoration' },
  { id: 6, src: 'https://premierdentalnc.com/wp-content/uploads/2024/08/6-800x1073.png.webp', alt: 'Before and after dental transformation case 6 — complete smile transformation' },
  { id: 7, src: 'https://premierdentalnc.com/wp-content/uploads/2024/08/7-800x1073.png.webp', alt: 'Before and after dental transformation case 7 — cosmetic dental work' },
  { id: 8, src: 'https://premierdentalnc.com/wp-content/uploads/2024/08/8-800x1073.png.webp', alt: 'Before and after dental transformation case 8 — complete dental makeover' },
];
---

<section id="our-work" class="py-20 lg:py-28 bg-white" aria-labelledby="our-work-heading">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <!-- Section Header -->
    <div class="text-center max-w-3xl mx-auto mb-16">
      <p class="text-sm font-semibold text-primary uppercase tracking-wider mb-3">Our Work</p>
      <h2 id="our-work-heading" class="font-heading text-3xl sm:text-4xl lg:text-5xl font-bold text-text">
        Real Results. Real Smiles.
      </h2>
      <p class="mt-5 text-text-light leading-relaxed text-lg">
        See the transformations our patients have experienced through cosmetic, restorative, and advanced dental care at Premier Dental.
      </p>
    </div>

    <!-- Before & After Gallery -->
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-6">
      {cases.map((item) => (
        <button
          class="our-work-card group relative rounded-2xl overflow-hidden shadow-md hover:shadow-xl transition-all duration-300 cursor-pointer bg-bg-alt border border-border hover:border-primary/30 focus:outline-none focus:ring-2 focus:ring-primary/50 focus:ring-offset-2"
          data-src={item.src}
          data-alt={item.alt}
          aria-label={`View ${item.alt}`}
        >
          <div class="aspect-[3/4] overflow-hidden">
            <img
              src={item.src}
              alt={item.alt}
              width="800"
              height="1073"
              class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
              loading="lazy"
            />
          </div>
          <!-- Hover Overlay -->
          <div class="absolute inset-0 bg-gradient-to-t from-primary/80 via-primary/20 to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-300 flex items-end justify-center pb-6">
            <span class="text-white text-sm font-semibold flex items-center gap-2">
              <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0zM10 7v3m0 0v3m0-3h3m-3 0H7" />
              </svg>
              View Transformation
            </span>
          </div>
          <!-- Case Number Badge -->
          <div class="absolute top-3 left-3 bg-white/90 backdrop-blur-sm text-primary text-xs font-bold rounded-full w-8 h-8 flex items-center justify-center shadow-sm">
            {item.id}
          </div>
        </button>
      ))}
    </div>

    <!-- CTA -->
    <div class="mt-16 text-center bg-bg-alt rounded-2xl p-10 lg:p-14 border border-border">
      <h3 class="font-heading text-2xl sm:text-3xl font-bold text-text">
        Ready for Your Transformation?
      </h3>
      <p class="mt-4 text-text-light max-w-2xl mx-auto leading-relaxed">
        Whether you need cosmetic work, restorative care, or a complete smile makeover — we're here to help you achieve the smile you've always wanted.
      </p>
      <div class="mt-8 flex flex-col sm:flex-row items-center justify-center gap-4">
        <a
          href="/#contact"
          class="inline-flex items-center px-8 py-3.5 bg-primary text-white font-semibold rounded-full hover:bg-primary-dark transition-colors shadow-lg shadow-primary/20"
        >
          Request an Appointment
        </a>
        <div class="flex items-center gap-4 text-sm text-text-light">
          <a href="tel:7049825516" class="hover:text-primary transition-colors">Albemarle: (704) 982-5516</a>
          <span class="text-border">|</span>
          <a href="tel:7046887120" class="hover:text-primary transition-colors">Charlotte: (704) 688-7120</a>
        </div>
      </div>
    </div>
  </div>

  <!-- Lightbox Modal -->
  <div id="our-work-lightbox" class="fixed inset-0 z-[100] hidden items-center justify-center bg-black/85 backdrop-blur-sm p-4" role="dialog" aria-modal="true" aria-label="Image viewer">
    <button id="lightbox-close" class="absolute top-4 right-4 z-10 text-white/80 hover:text-white transition-colors p-2" aria-label="Close image viewer">
      <svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
      </svg>
    </button>
    <button id="lightbox-prev" class="absolute left-4 top-1/2 -translate-y-1/2 z-10 text-white/80 hover:text-white transition-colors p-2 bg-white/10 rounded-full hover:bg-white/20" aria-label="Previous image">
      <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7" />
      </svg>
    </button>
    <button id="lightbox-next" class="absolute right-4 top-1/2 -translate-y-1/2 z-10 text-white/80 hover:text-white transition-colors p-2 bg-white/10 rounded-full hover:bg-white/20" aria-label="Next image">
      <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
      </svg>
    </button>
    <img id="lightbox-img" src="" alt="" class="max-w-full max-h-[90vh] rounded-xl shadow-2xl object-contain" />
  </div>
</section>

<script>
  const cards = document.querySelectorAll('.our-work-card');
  const lightbox = document.getElementById('our-work-lightbox');
  const lightboxImg = document.getElementById('lightbox-img') as HTMLImageElement;
  const closeBtn = document.getElementById('lightbox-close');
  const prevBtn = document.getElementById('lightbox-prev');
  const nextBtn = document.getElementById('lightbox-next');

  const images = Array.from(cards).map(card => ({
    src: card.getAttribute('data-src') || '',
    alt: card.getAttribute('data-alt') || '',
  }));

  let currentIndex = 0;

  function openLightbox(index: number) {
    currentIndex = index;
    lightboxImg.src = images[index].src;
    lightboxImg.alt = images[index].alt;
    lightbox?.classList.remove('hidden');
    lightbox?.classList.add('flex');
    document.body.style.overflow = 'hidden';
  }

  function closeLightbox() {
    lightbox?.classList.add('hidden');
    lightbox?.classList.remove('flex');
    document.body.style.overflow = '';
  }

  function navigate(direction: number) {
    currentIndex = (currentIndex + direction + images.length) % images.length;
    lightboxImg.src = images[currentIndex].src;
    lightboxImg.alt = images[currentIndex].alt;
  }

  cards.forEach((card, i) => {
    card.addEventListener('click', () => openLightbox(i));
  });

  closeBtn?.addEventListener('click', closeLightbox);
  prevBtn?.addEventListener('click', () => navigate(-1));
  nextBtn?.addEventListener('click', () => navigate(1));

  lightbox?.addEventListener('click', (e) => {
    if (e.target === lightbox) closeLightbox();
  });

  document.addEventListener('keydown', (e) => {
    if (lightbox?.classList.contains('hidden')) return;
    if (e.key === 'Escape') closeLightbox();
    if (e.key === 'ArrowLeft') navigate(-1);
    if (e.key === 'ArrowRight') navigate(1);
  });
</script>
