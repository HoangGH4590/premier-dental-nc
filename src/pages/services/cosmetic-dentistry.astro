---
import ServiceLayout from '../../layouts/ServiceLayout.astro';

const procedures = [
  { num: '1', title: 'Teeth Whitening', desc: 'Professional whitening treatments deliver quicker and more noticeable results compared to at-home options, effectively reducing stains caused by coffee, tea, smoking, and other factors.' },
  { num: '2', title: 'Dental Veneers', desc: 'Thin, custom-made porcelain or composite resin shells designed to cover the front surface of your teeth, concealing imperfections such as stains, chips, or gaps.' },
  { num: '3', title: 'Dental Crowns', desc: 'Caps that completely cover and protect a damaged or weakened tooth, restoring its shape, size, and strength with a natural appearance.' },
  { num: '4', title: 'Orthodontics & Invisalign', desc: 'From traditional braces to modern clear aligners, orthodontics can address overcrowding, spacing, and bite irregularities discreetly and comfortably.' },
  { num: '5', title: 'Dental Bonding', desc: 'A simple, cost-effective procedure using tooth-colored resin to repair chips, cracks, discoloration, and gaps -- often completed in just one visit.' },
  { num: '6', title: 'Inlays & Onlays', desc: 'Custom restorations for teeth too damaged for a filling but not enough for a crown. Made from porcelain, composite resin, or gold for durability.' },
  { num: '7', title: 'Gum Contouring', desc: "Improves the appearance of your gumline using advanced dental lasers, ideal for individuals with a 'gummy smile' or uneven gums." },
  { num: '8', title: 'Smile Makeover', desc: 'A comprehensive, personalized treatment plan combining multiple procedures to address discoloration, misalignment, and uneven teeth for your dream smile.' },
  { num: '9', title: 'Full Mouth Reconstruction', desc: 'For patients with extensive dental issues -- combining crowns, bridges, veneers, implants, and gum treatments to restore functionality and aesthetics.' },
  { num: '10', title: 'Cosmetic Dental Implants', desc: 'The gold standard for replacing missing teeth. Titanium posts provide a sturdy foundation for natural-looking crowns that last a lifetime.' },
];

const schema = {
  "@context": "https://schema.org",
  "@type": "MedicalWebPage",
  "name": "Cosmetic Dentistry | Premier Dental | Albemarle & Charlotte, NC",
  "description": "Cosmetic dentistry procedures at Premier Dental including teeth whitening, veneers, dental crowns, bonding, Invisalign, smile makeovers, and more in Charlotte and Albemarle, NC.",
  "mainEntity": {
    "@type": "MedicalProcedure",
    "name": "Cosmetic Dentistry",
    "procedureType": "http://schema.org/NoninvasiveProcedure"
  }
};
---

<ServiceLayout
  title="Cosmetic Dentistry | Premier Dental | Albemarle & Charlotte, NC"
  description="Cosmetic dentistry procedures at Premier Dental including teeth whitening, veneers, dental crowns, bonding, Invisalign, smile makeovers, and more in Charlotte and Albemarle, NC."
  keywords="cosmetic dentistry Albemarle NC, teeth whitening Charlotte NC, dental veneers, smile makeover, dental bonding, gum contouring"
  schema={schema}
>
  <!-- Hero -->
  <section class="relative bg-bg-alt py-20 lg:py-28">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid lg:grid-cols-2 gap-12 items-center">
        <div>
          <a href="/#services" class="inline-flex items-center gap-1.5 text-sm font-medium text-primary hover:underline mb-6">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"/></svg>
            Back to Services
          </a>
          <h1 class="font-heading text-4xl sm:text-5xl lg:text-6xl font-bold text-text">Cosmetic Dentistry</h1>
          <p class="mt-6 text-lg text-text-light leading-relaxed">
            Cosmetic dentistry addresses new challenges and gives patients more choices. Bring beauty, harmony smile to everyone.
          </p>
          <ul class="mt-4 space-y-2 text-text-light text-sm">
            <li class="flex items-start gap-2"><span class="text-primary mt-0.5">&#10003;</span> Improving appearance with whitening, veneers, and bonding</li>
            <li class="flex items-start gap-2"><span class="text-primary mt-0.5">&#10003;</span> Enhancing the overall symmetry, proportion, and balance of your smile</li>
            <li class="flex items-start gap-2"><span class="text-primary mt-0.5">&#10003;</span> Boosting self-esteem and confidence in social and professional settings</li>
            <li class="flex items-start gap-2"><span class="text-primary mt-0.5">&#10003;</span> Long-lasting results with proper care</li>
            <li class="flex items-start gap-2"><span class="text-primary mt-0.5">&#10003;</span> Customized to meet individual needs and preferences</li>
          </ul>
          <div class="mt-8 space-y-5">
            <div class="flex flex-col sm:flex-row gap-3">
              <a href="tel:7049825516" class="inline-flex items-center justify-center gap-2 px-6 py-3.5 bg-white text-primary font-semibold rounded-full border-2 border-primary/20 hover:border-primary hover:bg-primary/5 transition-colors shadow-md">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/></svg>
                Albemarle (704) 982-5516
              </a>
              <a href="tel:7046887120" class="inline-flex items-center justify-center gap-2 px-6 py-3.5 bg-white text-primary font-semibold rounded-full border-2 border-primary/20 hover:border-primary hover:bg-primary/5 transition-colors shadow-md">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/></svg>
                Charlotte (704) 688-7120
              </a>
            </div>
            <a href="/#contact" class="inline-flex items-center justify-center gap-2 px-6 py-3.5 bg-primary text-white font-semibold rounded-full hover:bg-primary-dark transition-colors shadow-lg shadow-primary/20">
              Request a Consultation
            </a>
          </div>
        </div>
        <div class="rounded-2xl overflow-hidden shadow-2xl">
          <img src="/wp-content/uploads/2024/12/2.jpg" alt="Cosmetic dentistry procedures at Premier Dental Charlotte NC" width="600" height="400" class="w-full h-auto object-cover" loading="eager" />
        </div>
      </div>
    </div>
  </section>

  <!-- Intro -->
  <section class="py-20 bg-white">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
      <p class="text-lg text-text-light leading-relaxed">
        Not everyone is born with a gorgeous smile, but cosmetic dentistry can help you get the look you've always desired. These procedures, conducted by qualified specialists, not only improve the appearance of your teeth but also repair damage caused by accidents or pre-existing conditions. Whether through teeth whitening, veneers, or other procedures, cosmetic dentistry can transform your smile and enhance your confidence.
      </p>
    </div>
  </section>

  <!-- 10 Procedures -->
  <section class="py-20 bg-bg-alt">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <h2 class="font-heading text-3xl sm:text-4xl font-bold text-text text-center mb-12">10 Cosmetic Dentistry Procedures</h2>
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-2 gap-6">
        {procedures.map((proc) => (
          <div class="bg-white rounded-2xl p-6 border border-border hover:border-primary/30 hover:shadow-lg transition-all flex gap-4">
            <span class="text-3xl font-bold text-primary/20 font-heading shrink-0">{proc.num}</span>
            <div>
              <h3 class="font-heading text-lg font-semibold text-text mb-2">{proc.title}</h3>
              <p class="text-sm text-text-light leading-relaxed">{proc.desc}</p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Why Choose Premier Dental for Cosmetic Dentistry -->
  <section class="py-16 lg:py-20 bg-white">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
      <h2 class="font-heading text-2xl sm:text-3xl font-bold text-text mb-6">Why Choose Premier Dental for Cosmetic Dentistry in Albemarle and Charlotte, NC</h2>
      <p class="text-text-light leading-relaxed mb-6">
        Your smile is one of the first things people notice. At Premier Dental, we combine artistic skill with advanced dental technology to create stunning, natural-looking results that enhance your confidence and transform how you feel about your appearance. Patients across Albemarle, Charlotte, Stanly County, and the greater Mecklenburg County area trust our cosmetic dentistry team for good reason.
      </p>
      <div class="space-y-4">
        <div class="flex items-start gap-3 p-4 bg-bg rounded-xl border border-border">
          <svg class="w-5 h-5 text-primary mt-0.5 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" /></svg>
          <div>
            <span class="font-medium text-text">Personalized Smile Design</span>
            <p class="text-sm text-text-light mt-1">No two smiles are alike. Our cosmetic dentists take the time to understand your aesthetic goals, facial features, and lifestyle before recommending any procedure. Whether you want subtle refinement or a complete smile makeover, your treatment plan is tailored specifically to you.</p>
          </div>
        </div>
        <div class="flex items-start gap-3 p-4 bg-bg rounded-xl border border-border">
          <svg class="w-5 h-5 text-primary mt-0.5 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" /></svg>
          <div>
            <span class="font-medium text-text">State-of-the-Art Technology</span>
            <p class="text-sm text-text-light mt-1">We use digital smile design software, high-resolution intraoral cameras, and professional-grade whitening systems to deliver predictable, beautiful outcomes. Our Albemarle and Charlotte offices are equipped with the latest dental technology for precision and comfort.</p>
          </div>
        </div>
        <div class="flex items-start gap-3 p-4 bg-bg rounded-xl border border-border">
          <svg class="w-5 h-5 text-primary mt-0.5 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" /></svg>
          <div>
            <span class="font-medium text-text">Comprehensive Range of Cosmetic Services</span>
            <p class="text-sm text-text-light mt-1">From quick one-visit bonding and professional whitening to porcelain veneers, gum contouring, and full smile makeovers, we offer the complete spectrum of cosmetic dental treatments under one roof. You do not need referrals to multiple offices -- everything is available at Premier Dental.</p>
          </div>
        </div>
        <div class="flex items-start gap-3 p-4 bg-bg rounded-xl border border-border">
          <svg class="w-5 h-5 text-primary mt-0.5 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" /></svg>
          <div>
            <span class="font-medium text-text">Natural-Looking, Long-Lasting Results</span>
            <p class="text-sm text-text-light mt-1">We partner with top-tier dental laboratories and use premium materials -- including high-translucency porcelain and advanced composite resins -- to ensure your cosmetic restorations look indistinguishable from natural teeth and stand the test of time.</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- What to Expect -->
  <section class="py-16 lg:py-20 bg-bg-alt">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
      <h2 class="font-heading text-2xl sm:text-3xl font-bold text-text mb-6">What to Expect During a Cosmetic Dentistry Consultation</h2>
      <p class="text-text-light leading-relaxed mb-4">
        Every cosmetic transformation at Premier Dental begins with a thoughtful consultation. Here is what the process looks like from your first call to your final result.
      </p>
      <div class="space-y-6 mt-8">
        <div class="flex gap-4 items-start">
          <span class="w-8 h-8 bg-primary text-white rounded-full flex items-center justify-center text-sm font-bold shrink-0">1</span>
          <div>
            <h3 class="font-heading text-lg font-semibold text-text mb-1">Initial Smile Assessment</h3>
            <p class="text-text-light leading-relaxed">During your first visit to our Albemarle or Charlotte office, we conduct a comprehensive examination of your teeth, gums, and bite. We take digital photographs, X-rays, and impressions to assess the current state of your smile and identify areas for improvement. Most importantly, we listen to what you want to change and what your ideal outcome looks like.</p>
          </div>
        </div>
        <div class="flex gap-4 items-start">
          <span class="w-8 h-8 bg-primary text-white rounded-full flex items-center justify-center text-sm font-bold shrink-0">2</span>
          <div>
            <h3 class="font-heading text-lg font-semibold text-text mb-1">Custom Treatment Plan</h3>
            <p class="text-text-light leading-relaxed">Based on your assessment, we create a personalized treatment plan that may include a single procedure or a combination of treatments. We discuss timelines, expected results, costs, and alternative options so you can make a fully informed decision. For smile makeovers, we may use digital previews to help you visualize the final outcome before treatment begins.</p>
          </div>
        </div>
        <div class="flex gap-4 items-start">
          <span class="w-8 h-8 bg-primary text-white rounded-full flex items-center justify-center text-sm font-bold shrink-0">3</span>
          <div>
            <h3 class="font-heading text-lg font-semibold text-text mb-1">Treatment and Transformation</h3>
            <p class="text-text-light leading-relaxed">Treatment timelines vary by procedure. Professional teeth whitening can be completed in a single visit, dental bonding typically takes under an hour per tooth, and porcelain veneers usually require two appointments spaced about two weeks apart. Throughout every step, our team ensures your comfort and keeps you informed about progress. Most cosmetic procedures involve minimal to no discomfort.</p>
          </div>
        </div>
        <div class="flex gap-4 items-start">
          <span class="w-8 h-8 bg-primary text-white rounded-full flex items-center justify-center text-sm font-bold shrink-0">4</span>
          <div>
            <h3 class="font-heading text-lg font-semibold text-text mb-1">Maintenance and Follow-Up</h3>
            <p class="text-text-light leading-relaxed">After your cosmetic treatment is complete, we schedule follow-up visits to ensure everything looks and functions perfectly. We also provide personalized maintenance guidelines -- including dietary recommendations, oral hygiene tips, and touch-up schedules -- to help your new smile last as long as possible. Regular <a href="/services/preventive-dentistry" class="text-primary hover:underline">preventive dental care</a> is essential for protecting your cosmetic investment.</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Cosmetic Dentistry FAQ -->
  <section class="py-16 lg:py-20 bg-white">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
      <h2 class="font-heading text-2xl sm:text-3xl font-bold text-text mb-8 text-center">Frequently Asked Questions About Cosmetic Dentistry</h2>
      <div class="space-y-3">
        <details class="group bg-white rounded-xl border border-border overflow-hidden hover:border-primary/30 transition-colors">
          <summary class="flex items-center justify-between cursor-pointer px-6 py-5 text-left">
            <span class="font-medium text-text pr-4">How long does professional teeth whitening last?</span>
            <svg class="w-5 h-5 text-text-light shrink-0 transition-transform group-open:rotate-180" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/></svg>
          </summary>
          <div class="px-6 pb-5 text-text-light leading-relaxed">Professional teeth whitening results typically last between 6 months and 2 years, depending on your dietary habits and oral hygiene routine. Coffee, tea, red wine, and tobacco can accelerate staining. We recommend periodic touch-up treatments and using a whitening toothpaste to maintain your bright smile. At Premier Dental in Charlotte and Albemarle, NC, we offer both in-office and take-home whitening options. Learn more in our <a href="/blog/teeth-whitening" class="text-primary hover:underline">teeth whitening guide</a>.</div>
        </details>
        <details class="group bg-white rounded-xl border border-border overflow-hidden hover:border-primary/30 transition-colors">
          <summary class="flex items-center justify-between cursor-pointer px-6 py-5 text-left">
            <span class="font-medium text-text pr-4">Are dental veneers permanent?</span>
            <svg class="w-5 h-5 text-text-light shrink-0 transition-transform group-open:rotate-180" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/></svg>
          </summary>
          <div class="px-6 pb-5 text-text-light leading-relaxed">Porcelain veneers are considered a permanent cosmetic treatment because a thin layer of enamel is removed to accommodate the veneer. Once placed, they cannot be reversed. However, veneers are not indestructible -- they typically last 10 to 20 years before needing replacement. With proper care, including avoiding biting hard objects and maintaining good oral hygiene, your veneers can remain beautiful for well over a decade. Read our detailed <a href="/blog/dental-veneers-in-charlotte" class="text-primary hover:underline">dental veneers guide</a> for more information.</div>
        </details>
        <details class="group bg-white rounded-xl border border-border overflow-hidden hover:border-primary/30 transition-colors">
          <summary class="flex items-center justify-between cursor-pointer px-6 py-5 text-left">
            <span class="font-medium text-text pr-4">What is dental bonding and how long does it last?</span>
            <svg class="w-5 h-5 text-text-light shrink-0 transition-transform group-open:rotate-180" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/></svg>
          </summary>
          <div class="px-6 pb-5 text-text-light leading-relaxed">Dental bonding uses tooth-colored composite resin to repair chips, cracks, gaps, and discoloration. It is one of the most affordable and quickest cosmetic procedures -- often completed in a single visit of 30 to 60 minutes per tooth. Bonding typically lasts 5 to 10 years, depending on where the bonding is placed and your oral habits. It is an excellent option for minor cosmetic improvements without the commitment of veneers. Explore our <a href="/blog/cosmetic-dental-bonding" class="text-primary hover:underline">cosmetic dental bonding article</a> for a detailed overview.</div>
        </details>
        <details class="group bg-white rounded-xl border border-border overflow-hidden hover:border-primary/30 transition-colors">
          <summary class="flex items-center justify-between cursor-pointer px-6 py-5 text-left">
            <span class="font-medium text-text pr-4">Can cosmetic dentistry fix crooked teeth without braces?</span>
            <svg class="w-5 h-5 text-text-light shrink-0 transition-transform group-open:rotate-180" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/></svg>
          </summary>
          <div class="px-6 pb-5 text-text-light leading-relaxed">In some cases, yes. Porcelain veneers can create the appearance of straighter teeth by covering misalignment, and dental bonding can improve the look of mildly uneven teeth. However, for significant alignment issues, orthodontic treatment such as <a href="/services/invisalign" class="text-primary hover:underline">Invisalign clear aligners</a> is generally the best approach for both aesthetics and long-term oral health. During your consultation at our Albemarle or Charlotte office, we will recommend the most effective approach for your specific situation.</div>
        </details>
        <details class="group bg-white rounded-xl border border-border overflow-hidden hover:border-primary/30 transition-colors">
          <summary class="flex items-center justify-between cursor-pointer px-6 py-5 text-left">
            <span class="font-medium text-text pr-4">What is a smile makeover and who is it for?</span>
            <svg class="w-5 h-5 text-text-light shrink-0 transition-transform group-open:rotate-180" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/></svg>
          </summary>
          <div class="px-6 pb-5 text-text-light leading-relaxed">A smile makeover is a comprehensive, customized treatment plan that combines multiple cosmetic procedures to address various concerns at once -- such as discoloration, chips, gaps, uneven gums, and misalignment. It is ideal for patients who have several aesthetic issues they want to correct simultaneously. At Premier Dental, our smile makeover process begins with a detailed assessment and digital preview so you can see the potential results before committing to treatment. Learn more about our full range of <a href="/blog/cosmetic-dentistry" class="text-primary hover:underline">cosmetic dentistry options</a>.</div>
        </details>
      </div>
    </div>
  </section>

  <!-- Insurance and Pricing -->
  <section class="py-16 lg:py-20 bg-bg-alt">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
      <h2 class="font-heading text-2xl sm:text-3xl font-bold text-text mb-6">Cosmetic Dentistry Insurance and Pricing</h2>
      <p class="text-text-light leading-relaxed mb-4">
        Cosmetic dentistry pricing varies significantly depending on the procedure. A simple teeth whitening session is considerably less than a full set of porcelain veneers or a complete smile makeover. Some cosmetic procedures that also serve a restorative function -- such as dental crowns or bonding to repair a broken tooth -- may be partially covered by dental insurance.
      </p>
      <p class="text-text-light leading-relaxed mb-4">
        At Premier Dental, we accept most major dental insurance plans and will help you understand which portions of your cosmetic treatment may be covered. For procedures not covered by insurance, we offer flexible payment options to make your dream smile accessible.
      </p>
      <p class="text-text-light leading-relaxed">
        Contact our Albemarle office at <a href="tel:7049825516" class="text-primary font-semibold hover:underline">(704) 982-5516</a> or our Charlotte office at <a href="tel:7046887120" class="text-primary font-semibold hover:underline">(704) 688-7120</a> to schedule a consultation and receive a personalized estimate for your cosmetic treatment plan.
      </p>
    </div>
  </section>

  <!-- Related Resources -->
  <section class="py-16 lg:py-20 bg-white">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
      <h2 class="font-heading text-2xl sm:text-3xl font-bold text-text mb-6">Explore Our Cosmetic Dentistry Resources</h2>
      <p class="text-text-light leading-relaxed mb-6">
        Dive deeper into specific cosmetic procedures with our educational blog posts and related service pages.
      </p>
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
        <a href="/blog/dental-veneers-in-charlotte" class="flex items-center gap-3 p-4 bg-bg rounded-xl border border-border hover:border-primary/30 hover:shadow-md transition-all">
          <svg class="w-5 h-5 text-primary shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/></svg>
          <span class="text-text font-medium text-sm">Dental Veneers in Charlotte -- Complete Guide</span>
        </a>
        <a href="/blog/teeth-whitening" class="flex items-center gap-3 p-4 bg-bg rounded-xl border border-border hover:border-primary/30 hover:shadow-md transition-all">
          <svg class="w-5 h-5 text-primary shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/></svg>
          <span class="text-text font-medium text-sm">Professional Teeth Whitening Guide</span>
        </a>
        <a href="/blog/cosmetic-dental-bonding" class="flex items-center gap-3 p-4 bg-bg rounded-xl border border-border hover:border-primary/30 hover:shadow-md transition-all">
          <svg class="w-5 h-5 text-primary shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/></svg>
          <span class="text-text font-medium text-sm">Cosmetic Dental Bonding -- Affordable Solutions</span>
