---
import ServiceLayout from '../../layouts/ServiceLayout.astro';

const services = [
  { title: 'Dental Cleanings', desc: "Professional cleanings every 6 months remove plaque and tartar buildup that regular brushing can't reach, keeping your teeth and gums healthy." },
  { title: 'Comprehensive Exams', desc: 'Thorough examinations to detect early signs of decay, gum disease, oral cancer, and other conditions before they become serious problems.' },
  { title: 'Digital X-Rays', desc: 'Advanced digital imaging allows us to see beneath the surface, detecting hidden cavities, bone loss, and other issues with minimal radiation exposure.' },
  { title: 'Fluoride Treatments', desc: 'Professional fluoride applications strengthen tooth enamel and help prevent cavities, especially beneficial for children and patients at higher risk of decay.' },
  { title: 'Dental Sealants', desc: 'Thin protective coatings applied to the chewing surfaces of back teeth to prevent decay in the grooves and pits where bacteria tend to accumulate.' },
  { title: 'Oral Cancer Screenings', desc: 'Regular screenings to detect early signs of oral cancer, significantly improving treatment outcomes when caught early.' },
];

const tips = [
  'Brush twice daily with fluoride toothpaste',
  'Floss at least once a day',
  'Visit your dentist every 6 months for cleanings and exams',
  'Limit sugary and acidic foods and beverages',
  "Don't use your teeth as tools",
  'Wear a mouthguard during sports',
  'Replace your toothbrush every 3-4 months',
];

const schema = {
  "@context": "https://schema.org",
  "@type": "MedicalWebPage",
  "name": "Preventive Dentistry | Premier Dental | Albemarle & Charlotte, NC",
  "description": "Preventive dental care at Premier Dental including cleanings, exams, screenings, fluoride treatments, and sealants. Keep your smile healthy in Albemarle and Charlotte, NC.",
  "mainEntity": {
    "@type": "MedicalProcedure",
    "name": "Preventive Dentistry",
    "procedureType": "http://schema.org/NoninvasiveProcedure"
  }
};

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {
      "@type": "Question",
      "name": "How often should I visit the dentist for a checkup?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "For most patients, we recommend a dental checkup and professional cleaning every 6 months. However, patients with a history of gum disease, high cavity risk, diabetes, or other health conditions may benefit from more frequent visits -- every 3 to 4 months. During your visit at our Albemarle or Charlotte office, your dentist will recommend a schedule tailored to your specific oral health needs."
      }
    },
    {
      "@type": "Question",
      "name": "Are dental X-rays safe?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Yes. Digital X-rays, which we use at Premier Dental, emit up to 90% less radiation than traditional film X-rays. The amount of radiation from a dental X-ray is extremely small -- comparable to the background radiation you receive from a short airplane flight. We follow the ALARA principle (As Low As Reasonably Achievable) and only take X-rays when clinically necessary to diagnose or monitor dental conditions."
      }
    },
    {
      "@type": "Question",
      "name": "What are dental sealants and who should get them?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Dental sealants are thin, protective coatings painted onto the chewing surfaces of back teeth (molars and premolars). They fill in the deep grooves and pits where bacteria and food particles tend to accumulate, reducing the risk of cavities by up to 80%. Sealants are most commonly applied to children and teenagers as soon as their permanent molars come in, but adults with deep grooves or a high risk of decay can also benefit. The application is quick, painless, and does not require drilling or anesthesia."
      }
    },
    {
      "@type": "Question",
      "name": "Can preventive dentistry help with gum disease?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Absolutely. Regular professional cleanings remove tartar buildup that contributes to gum disease, and routine examinations allow us to detect the earliest signs of gingivitis before it progresses to more serious periodontitis. If early gum disease is found, we can implement targeted treatments such as deep cleanings (scaling and root planing) to reverse the condition. Consistent preventive care is the single most effective way to prevent gum disease and the tooth loss it can cause."
      }
    },
    {
      "@type": "Question",
      "name": "Is fluoride treatment necessary for adults?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "While fluoride treatments are especially beneficial for children, many adults can benefit from them as well. Adults with dry mouth (often caused by medications), a history of frequent cavities, gum recession exposing tooth roots, or existing crowns and bridges may be excellent candidates for professional fluoride application. Your dentist at Premier Dental will assess your individual risk factors and recommend fluoride treatment if it would provide meaningful protection for your teeth."
      }
    }
  ]
};
---

<ServiceLayout
  title="Preventive Dentistry | Premier Dental | Albemarle & Charlotte, NC"
  description="Preventive dental care at Premier Dental including cleanings, exams, screenings, fluoride treatments, and sealants. Keep your smile healthy in Albemarle and Charlotte, NC."
  keywords="preventive dentistry Albemarle NC, dental cleaning Charlotte NC, dental exam, fluoride treatment, dental sealants, oral cancer screening"
  schema={schema}
  extraSchemas={[faqSchema]}
>
  <!-- Hero -->
  <section class="relative bg-bg-alt py-20 lg:py-28">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid lg:grid-cols-2 gap-12 items-center">
        <div>
          <a href="/#services" class="inline-flex items-center gap-1.5 text-sm font-medium text-primary hover:underline mb-6">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"/></svg>
            Back to Services
          </a>
          <h1 class="font-heading text-4xl sm:text-5xl lg:text-6xl font-bold text-text">Preventive Dentistry</h1>
          <p class="mt-6 text-lg text-text-light leading-relaxed">
            Preventive dentistry is a routine dental check-up for preventing and detecting dental diseases or deviations and, by dental measures, supporting means to protect your teeth and mouth.
          </p>
          <ul class="mt-4 space-y-2 text-text-light text-sm">
            <li class="flex items-start gap-2"><span class="text-primary mt-0.5">&#10003;</span> Reducing the risk of cavities, gum disease, and tooth loss</li>
            <li class="flex items-start gap-2"><span class="text-primary mt-0.5">&#10003;</span> Saving time and money by preventing costly treatments</li>
            <li class="flex items-start gap-2"><span class="text-primary mt-0.5">&#10003;</span> Improving overall health — good oral health impacts your well-being</li>
            <li class="flex items-start gap-2"><span class="text-primary mt-0.5">&#10003;</span> Enhancing quality of life by preventing pain and discomfort</li>
            <li class="flex items-start gap-2"><span class="text-primary mt-0.5">&#10003;</span> Maintaining a beautiful smile you can be confident about</li>
          </ul>
          <div class="mt-8 space-y-5">
            <div class="flex flex-col sm:flex-row gap-3">
              <a href="tel:7049825516" class="inline-flex items-center justify-center gap-2 px-6 py-3.5 bg-white text-primary font-semibold rounded-full border-2 border-primary/20 hover:border-primary hover:bg-primary/5 transition-colors shadow-md">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/></svg>
                Albemarle (704) 982-5516
              </a>
              <a href="tel:7046887120" class="inline-flex items-center justify-center gap-2 px-6 py-3.5 bg-white text-primary font-semibold rounded-full border-2 border-primary/20 hover:border-primary hover:bg-primary/5 transition-colors shadow-md">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/></svg>
                Charlotte (704) 688-7120
              </a>
            </div>
            <a href="/#contact" class="inline-flex items-center justify-center gap-2 px-6 py-3.5 bg-primary text-white font-semibold rounded-full hover:bg-primary-dark transition-colors shadow-lg shadow-primary/20">
              Book a Cleaning
            </a>
          </div>
        </div>
        <div class="rounded-2xl overflow-hidden shadow-2xl">
          <img src="/wp-content/uploads/2024/12/4.jpg" alt="Preventive dental care at Premier Dental Albemarle NC" width="600" height="400" class="w-full h-auto object-cover" loading="eager" />
        </div>
      </div>
    </div>
  </section>

  <!-- Why Preventive Care -->
  <section class="py-20 bg-white">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
      <h2 class="font-heading text-3xl sm:text-4xl font-bold text-text mb-6">Why Preventive Care Matters</h2>
      <p class="text-text-light leading-relaxed">
        Preventive dentistry is the foundation of a healthy smile. By catching problems early -- before they become painful or expensive -- we help you maintain your natural teeth for a lifetime. We recommend dental cleanings and checkups every 6 months for most patients. Regular preventive care saves you from more costly procedures down the road.
      </p>
      <p class="text-text-light leading-relaxed mt-4">
        At Premier Dental, our team stays on the cutting edge of preventive techniques, using the latest technology and evidence-based practices to protect your oral health at both our Albemarle and Charlotte locations.
      </p>
    </div>
  </section>

  <!-- Services Grid -->
  <section class="py-20 bg-bg-alt">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <h2 class="font-heading text-3xl sm:text-4xl font-bold text-text text-center mb-12">Our Preventive Services</h2>
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
        {services.map((svc) => (
          <div class="bg-white rounded-2xl p-6 border border-border hover:border-primary/30 hover:shadow-lg transition-all">
            <h3 class="font-heading text-lg font-semibold text-text mb-3">{svc.title}</h3>
            <p class="text-sm text-text-light leading-relaxed">{svc.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Tips -->
  <section class="py-20 bg-white">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
      <h2 class="font-heading text-3xl sm:text-4xl font-bold text-text text-center mb-12">Tips for a Healthy Smile</h2>
      <div class="space-y-3">
        {tips.map((tip) => (
          <div class="flex items-start gap-3 p-4 bg-bg rounded-xl">
            <svg class="w-5 h-5 text-primary mt-0.5 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
            </svg>
            <span class="text-text-light">{tip}</span>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Why Choose Premier Dental for Preventive Care -->
  <section class="py-16 lg:py-20 bg-bg-alt">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
      <h2 class="font-heading text-2xl sm:text-3xl font-bold text-text mb-6">Why Choose Premier Dental for Preventive Dentistry in Albemarle and Charlotte, NC</h2>
      <p class="text-text-light leading-relaxed mb-6">
        Preventive dental care is the most effective and affordable way to maintain your oral health for life. At Premier Dental, we make it easy for patients throughout Albemarle, Charlotte, Stanly County, and the surrounding North Carolina communities to stay on top of their dental health with thorough, comfortable, and personalized preventive care.
      </p>
      <div class="space-y-4">
        <div class="flex items-start gap-3 p-4 bg-white rounded-xl border border-border">
          <svg class="w-5 h-5 text-primary mt-0.5 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" /></svg>
          <div>
            <span class="font-medium text-text">Gentle, Thorough Cleanings</span>
            <p class="text-sm text-text-light mt-1">Our dental hygienists are skilled at providing thorough cleanings that remove plaque and tartar buildup while keeping you comfortable throughout the visit. Whether you have sensitive teeth or dental anxiety, we adapt our approach to meet your needs and ensure a positive experience every time.</p>
          </div>
        </div>
        <div class="flex items-start gap-3 p-4 bg-white rounded-xl border border-border">
          <svg class="w-5 h-5 text-primary mt-0.5 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" /></svg>
          <div>
            <span class="font-medium text-text">Advanced Diagnostic Technology</span>
            <p class="text-sm text-text-light mt-1">We use digital X-rays with up to 90% less radiation than traditional film, intraoral cameras for real-time visuals of your teeth and gums, and advanced screening tools for early detection of cavities, gum disease, and oral cancer. Catching problems early means simpler, less costly treatments.</p>
          </div>
        </div>
        <div class="flex items-start gap-3 p-4 bg-white rounded-xl border border-border">
          <svg class="w-5 h-5 text-primary mt-0.5 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" /></svg>
          <div>
            <span class="font-medium text-text">Comprehensive Care for All Ages</span>
            <p class="text-sm text-text-light mt-1">From children receiving their first dental sealants to adults maintaining lifelong oral health, our preventive services are tailored to patients of all ages. We emphasize age-appropriate education and treatment so every family member receives the care they need at our Albemarle and Charlotte offices.</p>
          </div>
        </div>
        <div class="flex items-start gap-3 p-4 bg-white rounded-xl border border-border">
          <svg class="w-5 h-5 text-primary mt-0.5 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" /></svg>
          <div>
            <span class="font-medium text-text">Personalized Oral Health Education</span>
            <p class="text-sm text-text-light mt-1">We do not just clean your teeth -- we empower you with knowledge. Our team takes time to demonstrate proper brushing and flossing techniques, discuss dietary factors that affect oral health, and create a personalized care plan based on your specific risk factors and goals.</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- What to Expect -->
  <section class="py-16 lg:py-20 bg-white">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
      <h2 class="font-heading text-2xl sm:text-3xl font-bold text-text mb-6">What to Expect During a Preventive Dental Visit</h2>
      <p class="text-text-light leading-relaxed mb-4">
        Regular preventive visits are the cornerstone of lasting oral health. At Premier Dental, we recommend checkups and cleanings every 6 months for most patients, though some individuals with higher risk factors may benefit from more frequent visits. Here is what a typical preventive visit looks like.
      </p>
      <div class="space-y-6 mt-8">
        <div class="flex gap-4 items-start">
          <span class="w-8 h-8 bg-primary text-white rounded-full flex items-center justify-center text-sm font-bold shrink-0">1</span>
          <div>
            <h3 class="font-heading text-lg font-semibold text-text mb-1">Comprehensive Oral Examination</h3>
            <p class="text-text-light leading-relaxed">Your dentist performs a thorough examination of your teeth, gums, tongue, and soft tissues. We check for signs of cavities, gum disease, tooth wear, bite problems, and early indicators of oral cancer. Digital X-rays may be taken to reveal issues hidden beneath the surface, such as decay between teeth or bone loss around the roots.</p>
          </div>
        </div>
        <div class="flex gap-4 items-start">
          <span class="w-8 h-8 bg-primary text-white rounded-full flex items-center justify-center text-sm font-bold shrink-0">2</span>
          <div>
            <h3 class="font-heading text-lg font-semibold text-text mb-1">Professional Cleaning (Prophylaxis)</h3>
            <p class="text-text-light leading-relaxed">Our dental hygienist carefully removes plaque and hardened tartar (calculus) from all surfaces of your teeth, including areas that are difficult to reach with regular brushing and flossing. After scaling, your teeth are polished to remove surface stains and create a smooth finish that resists future plaque buildup. Flossing is performed to ensure all interproximal areas are clean.</p>
          </div>
        </div>
        <div class="flex gap-4 items-start">
          <span class="w-8 h-8 bg-primary text-white rounded-full flex items-center justify-center text-sm font-bold shrink-0">3</span>
          <div>
            <h3 class="font-heading text-lg font-semibold text-text mb-1">Fluoride Treatment and Sealants (If Recommended)</h3>
            <p class="text-text-light leading-relaxed">For patients who would benefit from extra protection, we apply professional fluoride treatments to strengthen enamel and reduce cavity risk. Dental sealants may be recommended for children and teens -- or adults with deep grooves in their molars -- to create a protective barrier against decay on the chewing surfaces of back teeth.</p>
          </div>
        </div>
        <div class="flex gap-4 items-start">
          <span class="w-8 h-8 bg-primary text-white rounded-full flex items-center justify-center text-sm font-bold shrink-0">4</span>
          <div>
            <h3 class="font-heading text-lg font-semibold text-text mb-1">Personalized Care Plan and Education</h3>
            <p class="text-text-light leading-relaxed">Before you leave, your dentist reviews any findings and discusses a personalized care plan. If any issues were detected, we outline treatment options and timelines. We also provide tailored oral hygiene guidance, dietary recommendations, and answer any questions you may have. Your next preventive visit is scheduled so you can stay on track with your oral health goals.</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Preventive Dentistry FAQ -->
  <section class="py-16 lg:py-20 bg-bg-alt">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
      <h2 class="font-heading text-2xl sm:text-3xl font-bold text-text mb-8 text-center">Frequently Asked Questions About Preventive Dentistry</h2>
      <div class="space-y-3">
        <details class="group bg-white rounded-xl border border-border overflow-hidden hover:border-primary/30 transition-colors">
          <summary class="flex items-center justify-between cursor-pointer px-6 py-5 text-left">
            <span class="font-medium text-text pr-4">How often should I visit the dentist for a checkup?</span>
            <svg class="w-5 h-5 text-text-light shrink-0 transition-transform group-open:rotate-180" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/></svg>
          </summary>
          <div class="px-6 pb-5 text-text-light leading-relaxed">For most patients, we recommend a dental checkup and professional cleaning every 6 months. However, patients with a history of gum disease, high cavity risk, diabetes, or other health conditions may benefit from more frequent visits -- every 3 to 4 months. During your visit at our Albemarle or Charlotte office, your dentist will recommend a schedule tailored to your specific oral health needs.</div>
        </details>
        <details class="group bg-white rounded-xl border border-border overflow-hidden hover:border-primary/30 transition-colors">
          <summary class="flex items-center justify-between cursor-pointer px-6 py-5 text-left">
            <span class="font-medium text-text pr-4">Are dental X-rays safe?</span>
            <svg class="w-5 h-5 text-text-light shrink-0 transition-transform group-open:rotate-180" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/></svg>
          </summary>
          <div class="px-6 pb-5 text-text-light leading-relaxed">Yes. Digital X-rays, which we use at Premier Dental, emit up to 90% less radiation than traditional film X-rays. The amount of radiation from a dental X-ray is extremely small -- comparable to the background radiation you receive from a short airplane flight. We follow the ALARA principle (As Low As Reasonably Achievable) and only take X-rays when clinically necessary to diagnose or monitor dental conditions.</div>
        </details>
        <details class="group bg-white rounded-xl border border-border overflow-hidden hover:border-primary/30 transition-colors">
          <summary class="flex items-center justify-between cursor-pointer px-6 py-5 text-left">
            <span class="font-medium text-text pr-4">What are dental sealants and who should get them?</span>
            <svg class="w-5 h-5 text-text-light shrink-0 transition-transform group-open:rotate-180" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/></svg>
          </summary>
          <div class="px-6 pb-5 text-text-light leading-relaxed">Dental sealants are thin, protective coatings painted onto the chewing surfaces of back teeth (molars and premolars). They fill in the deep grooves and pits where bacteria and food particles tend to accumulate, reducing the risk of cavities by up to 80%. Sealants are most commonly applied to children and teenagers as soon as their permanent molars come in, but adults with deep grooves or a high risk of decay can also benefit. The application is quick, painless, and does not require drilling or anesthesia.</div>
        </details>
        <details class="group bg-white rounded-xl border border-border overflow-hidden hover:border-primary/30 transition-colors">
          <summary class="flex items-center justify-between cursor-pointer px-6 py-5 text-left">
            <span class="font-medium text-text pr-4">Can preventive dentistry help with gum disease?</span>
            <svg class="w-5 h-5 text-text-light shrink-0 transition-transform group-open:rotate-180" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/></svg>
          </summary>
          <div class="px-6 pb-5 text-text-light leading-relaxed">Absolutely. Regular professional cleanings remove tartar buildup that contributes to gum disease, and routine examinations allow us to detect the earliest signs of gingivitis before it progresses to more serious periodontitis. If early gum disease is found, we can implement targeted treatments such as deep cleanings (scaling and root planing) to reverse the condition. Consistent preventive care is the single most effective way to prevent gum disease and the tooth loss it can cause. Learn more about <a href="/blog/restorative-procedures-for-gum-health" class="text-primary hover:underline">restorative procedures for gum health</a>.</div>
        </details>
        <details class="group bg-white rounded-xl border border-border overflow-hidden hover:border-primary/30 transition-colors">
          <summary class="flex items-center justify-between cursor-pointer px-6 py-5 text-left">
            <span class="font-medium text-text pr-4">Is fluoride treatment necessary for adults?</span>
            <svg class="w-5 h-5 text-text-light shrink-0 transition-transform group-open:rotate-180" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/></svg>
          </summary>
          <div class="px-6 pb-5 text-text-light leading-relaxed">While fluoride treatments are especially beneficial for children, many adults can benefit from them as well. Adults with dry mouth (often caused by medications), a history of frequent cavities, gum recession exposing tooth roots, or existing crowns and bridges may be excellent candidates for professional fluoride application. Your dentist at Premier Dental will assess your individual risk factors and recommend fluoride treatment if it would provide meaningful protection for your teeth.</div>
        </details>
      </div>
    </div>
  </section>

  <!-- Insurance and Pricing -->
  <section class="py-16 lg:py-20 bg-white">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
      <h2 class="font-heading text-2xl sm:text-3xl font-bold text-text mb-6">Preventive Dentistry Insurance and Pricing</h2>
      <p class="text-text-light leading-relaxed mb-4">
        Preventive dental care is one of the most widely covered services under dental insurance plans. Most insurance plans cover two cleanings and exams per year at 100%, making preventive visits one of the most valuable benefits you can use. Fluoride treatments and sealants are also frequently covered, particularly for children and teenagers.
      </p>
      <p class="text-text-light leading-relaxed mb-4">
        At Premier Dental, we accept most major dental insurance plans and will verify your benefits before your appointment so you know exactly what to expect. For patients without insurance, we offer competitive self-pay rates for preventive services.
      </p>
      <p class="text-text-light leading-relaxed">
        Contact our Albemarle office at <a href="tel:7049825516" class="text-primary font-semibold hover:underline">(704) 982-5516</a> or our Charlotte office at <a href="tel:7046887120" class="text-primary font-semibold hover:underline">(704) 688-7120</a> to schedule your next cleaning and checkup, or to ask about your insurance coverage.
      </p>
    </div>
  </section>

  <!-- Related Resources -->
  <section class="py-16 lg:py-20 bg-bg-alt">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
      <h2 class="font-heading text-2xl sm:text-3xl font-bold text-text mb-6">Related Services and Resources</h2>
      <p class="text-text-light leading-relaxed mb-6">
        Preventive care works hand-in-hand with other dental services to keep your smile healthy and beautiful. Explore these related pages for more information.
