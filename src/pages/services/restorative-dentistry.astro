---
import ServiceLayout from '../../layouts/ServiceLayout.astro';

const procedures = [
  { title: 'Dental Fillings', desc: 'A common method for restoring teeth affected by decay, fractures, or chipping. The filling material, often composite resin or amalgam, fills the cavity or gap, providing structural support and improving function.' },
  { title: 'Dental Crowns', desc: 'A crown, or "cap," encases a damaged tooth, restoring its shape, size, and strength. Crowns are highly durable and suitable for both aesthetic and functional purposes.' },
  { title: 'Dental Bridges', desc: 'Bridges replace one or more missing teeth by anchoring an artificial tooth to adjacent teeth. They restore chewing ability, prevent teeth from shifting, and enhance appearance.' },
  { title: 'Dental Implants', desc: 'A titanium post is surgically placed in the jawbone, acting as an artificial root. A crown, bridge, or denture is then attached, providing a secure, permanent restoration.' },
  { title: 'Dentures', desc: 'Removable appliances used to replace multiple missing teeth. They restore appearance and functionality, making it easier to eat, speak, and smile with confidence.' },
  { title: 'Inlays & Onlays', desc: "Often referred to as partial crowns, these are ideal when a filling is insufficient but a full crown is unnecessary. Inlays fit within the tooth's grooves while onlays extend over one or more cusps." },
  { title: 'Root Canal Therapy', desc: 'Essential for saving a tooth that has been severely decayed or infected. By removing the damaged pulp and sealing the tooth, root canal therapy prevents extraction.' },
  { title: 'Full Mouth Reconstruction', desc: 'A comprehensive approach to restore all teeth using a combination of crowns, bridges, fillings, and implants to rebuild oral health, functionality, and aesthetics.' },
];

const schema = {
  "@context": "https://schema.org",
  "@type": "MedicalWebPage",
  "name": "Restorative Dentistry | Premier Dental",
  "description": "Restorative dentistry services at Premier Dental including fillings, crowns, bridges, implants, dentures, root canal therapy, and full mouth reconstruction in Albemarle and Charlotte, NC.",
  "mainEntity": {
    "@type": "MedicalProcedure",
    "name": "Restorative Dentistry",
    "procedureType": "http://schema.org/NoninvasiveProcedure"
  }
};

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {
      "@type": "Question",
      "name": "How long do dental crowns last?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "With proper care, dental crowns typically last 10 to 15 years, and many patients enjoy their crowns for 20 years or more. The longevity depends on the material used (porcelain, zirconia, or porcelain-fused-to-metal), your oral hygiene habits, and whether you grind your teeth. At Premier Dental in Albemarle and Charlotte, NC, we use high-quality crown materials and precise fitting techniques to maximize the lifespan of every restoration."
      }
    },
    {
      "@type": "Question",
      "name": "Is a root canal painful?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Modern root canal therapy is far less uncomfortable than most people expect. With today's anesthesia and advanced techniques, the procedure feels similar to getting a standard filling. Most patients report that the toothache or infection that brought them in was far more painful than the root canal itself. After the procedure, mild soreness is normal for a few days but can be managed with over-the-counter pain medication."
      }
    },
    {
      "@type": "Question",
      "name": "What is the difference between a dental bridge and a dental implant?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "A dental bridge replaces missing teeth by anchoring artificial teeth to the natural teeth on either side of the gap. It does not require surgery but does require modifying the adjacent teeth. A dental implant, on the other hand, is a titanium post surgically placed in the jawbone that acts as an artificial root, supporting a crown independently without affecting neighboring teeth. Implants also help preserve jawbone density."
      }
    },
    {
      "@type": "Question",
      "name": "How do I know if I need a filling or a crown?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "The choice between a filling and a crown depends on the extent of damage to the tooth. Fillings are ideal for small to moderate cavities where plenty of healthy tooth structure remains. When decay or damage is more extensive -- affecting a large portion of the tooth or compromising its structural integrity -- a crown provides the full coverage and strength needed to protect the tooth long-term. In some cases, an inlay or onlay may be the perfect middle ground."
      }
    },
    {
      "@type": "Question",
      "name": "Can old metal fillings be replaced with tooth-colored ones?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Yes, old amalgam (metal) fillings can be safely removed and replaced with modern composite resin fillings that match the natural color of your teeth. Many patients choose to replace metal fillings for aesthetic reasons, and it can also be beneficial if the old filling is cracked, worn, or leaking. At Premier Dental, we use BPA-free composite materials for a durable, natural-looking result."
      }
    }
  ]
};
---

<ServiceLayout
  title="Restorative Dentistry | Premier Dental | Albemarle & Charlotte, NC"
  description="Restorative dentistry services at Premier Dental including fillings, crowns, bridges, implants, dentures, root canal therapy, and full mouth reconstruction in Albemarle and Charlotte, NC."
  keywords="restorative dentistry Albemarle NC, dental crowns Charlotte NC, dental fillings, dental bridges, root canal therapy, full mouth reconstruction"
  schema={schema}
  extraSchemas={[faqSchema]}
>
  <!-- Hero -->
  <section class="relative bg-bg-alt py-20 lg:py-28">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid lg:grid-cols-2 gap-12 items-center">
        <div>
          <a href="/#services" class="inline-flex items-center gap-1.5 text-sm font-medium text-primary hover:underline mb-6">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"/></svg>
            Back to Services
          </a>
          <h1 class="font-heading text-4xl sm:text-5xl lg:text-6xl font-bold text-text">Restorative Dentistry</h1>
          <p class="mt-6 text-lg text-text-light leading-relaxed">
            Restorative dentistry is the term used to explain the replacement of lost or damaged teeth with popular methods: fillings, porcelain crowns, bridges, and implants.
          </p>
          <ul class="mt-4 space-y-2 text-text-light text-sm">
            <li class="flex items-start gap-2"><span class="text-primary mt-0.5">&#10003;</span> Improving the appearance of the teeth with fillings, crowns, and veneers</li>
            <li class="flex items-start gap-2"><span class="text-primary mt-0.5">&#10003;</span> Restoring function — chew, speak, and smile with confidence</li>
            <li class="flex items-start gap-2"><span class="text-primary mt-0.5">&#10003;</span> Strengthening teeth and making them more resistant to further damage</li>
            <li class="flex items-start gap-2"><span class="text-primary mt-0.5">&#10003;</span> Preserving natural tooth structure by filling cavities and repairing cracks</li>
            <li class="flex items-start gap-2"><span class="text-primary mt-0.5">&#10003;</span> Enhancing oral health and reducing the risk of future dental problems</li>
          </ul>
          <div class="mt-8 space-y-5">
            <div class="flex flex-col sm:flex-row gap-3">
              <a href="tel:7049825516" class="inline-flex items-center justify-center gap-2 px-6 py-3.5 bg-white text-primary font-semibold rounded-full border-2 border-primary/20 hover:border-primary hover:bg-primary/5 transition-colors shadow-md">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/></svg>
                Albemarle (704) 982-5516
              </a>
              <a href="tel:7046887120" class="inline-flex items-center justify-center gap-2 px-6 py-3.5 bg-white text-primary font-semibold rounded-full border-2 border-primary/20 hover:border-primary hover:bg-primary/5 transition-colors shadow-md">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/></svg>
                Charlotte (704) 688-7120
              </a>
            </div>
            <a href="/#contact" class="inline-flex items-center justify-center gap-2 px-6 py-3.5 bg-primary text-white font-semibold rounded-full hover:bg-primary-dark transition-colors shadow-lg shadow-primary/20">
              Request an Appointment
            </a>
          </div>
        </div>
        <div class="rounded-2xl overflow-hidden shadow-2xl">
          <img src="/wp-content/uploads/2024/08/1.jpg" alt="Restorative dentistry at Premier Dental in Charlotte NC" width="600" height="400" class="w-full h-auto object-cover" loading="eager" />
        </div>
      </div>
    </div>
  </section>

  <!-- What is it -->
  <section class="py-20 bg-white">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
      <h2 class="font-heading text-3xl sm:text-4xl font-bold text-text mb-6">What is Restorative Dentistry?</h2>
      <p class="text-text-light leading-relaxed">
        Restorative dentistry involves the repair and replacement of damaged or missing teeth through a variety of procedures, such as fillings, crowns, bridges, and implants. At Premier Dental, we stay at the forefront of restorative techniques and materials, committed to providing effective and long-lasting solutions to restore dental health impacted by decay, trauma, or wear.
      </p>

      <h2 class="font-heading text-3xl sm:text-4xl font-bold text-text mt-16 mb-6">Why is Restorative Dentistry Important?</h2>
      <p class="text-text-light leading-relaxed">
        Restorative dentistry plays a vital role in maintaining oral health and overall well-being. Restoring damaged teeth helps maintain correct positioning and alignment, which supports effective oral hygiene practices by making it easier to clean all areas of the mouth. This not only prevents plaque buildup but also reduces the risk of other dental issues.
      </p>
      <p class="text-text-light leading-relaxed mt-4">
        Furthermore, restorative procedures improve the aesthetics of your smile, boosting confidence and encouraging a positive self-image. In short, restorative dentistry ensures that your teeth remain healthy, functional, and beautiful.
      </p>
    </div>
  </section>

  <!-- Procedures -->
  <section class="py-20 bg-bg-alt">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <h2 class="font-heading text-3xl sm:text-4xl font-bold text-text text-center mb-12">Key Restorative Procedures</h2>
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
        {procedures.map((proc) => (
          <div class="bg-white rounded-2xl p-6 border border-border hover:border-primary/30 hover:shadow-lg transition-all">
            <h3 class="font-heading text-lg font-semibold text-text mb-3">{proc.title}</h3>
            <p class="text-sm text-text-light leading-relaxed">{proc.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Quality & Post-Treatment -->
  <section class="py-20 bg-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid md:grid-cols-2 gap-12">
        <div class="flex flex-col">
          <div class="rounded-2xl overflow-hidden shadow-lg mb-6">
            <img src="/wp-content/uploads/2024/12/22.jpg" alt="Restorative dentistry materials at Premier Dental" width="500" height="350" class="w-full h-64 object-cover" loading="lazy" />
          </div>
          <h3 class="font-heading text-2xl font-semibold text-text mb-3">Quality Materials</h3>
          <p class="text-text-light leading-relaxed">
            We use high-quality materials such as composite resins, porcelain, and titanium to ensure durable, natural-looking results. Each material is selected based on your specific needs for longevity and optimal aesthetics.
          </p>
        </div>
        <div class="flex flex-col">
          <div class="rounded-2xl overflow-hidden shadow-lg mb-6">
            <img src="/wp-content/uploads/2024/12/23.jpg" alt="Post-treatment dental care at Premier Dental NC" width="500" height="350" class="w-full h-64 object-cover" loading="lazy" />
          </div>
          <h3 class="font-heading text-2xl font-semibold text-text mb-3">Post-Treatment Care</h3>
          <p class="text-text-light leading-relaxed">
            Maintaining gum health is critical to the success of restorative procedures. We recommend regular cleanings, proper brushing techniques, and follow-up visits to ensure your restorations last a lifetime.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- Why Choose Premier Dental for Restorative Dentistry -->
  <section class="py-16 lg:py-20 bg-bg-alt">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
      <h2 class="font-heading text-2xl sm:text-3xl font-bold text-text mb-6">Why Choose Premier Dental for Restorative Dentistry in Albemarle and Charlotte, NC</h2>
      <p class="text-text-light leading-relaxed mb-6">
        When it comes to restoring your teeth, experience, technology, and a patient-centered approach make all the difference. At Premier Dental, we have helped thousands of patients across Albemarle, Charlotte, and the surrounding Stanly County and Mecklenburg County communities regain full dental function and confidence in their smiles. Here is what sets us apart from other restorative dentistry providers in the region.
      </p>
      <div class="space-y-4">
        <div class="flex items-start gap-3 p-4 bg-white rounded-xl border border-border">
          <svg class="w-5 h-5 text-primary mt-0.5 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" /></svg>
          <div>
            <span class="font-medium text-text">Advanced Digital Technology</span>
            <p class="text-sm text-text-light mt-1">We use digital X-rays, intraoral cameras, and CAD/CAM technology to plan and deliver precise restorations. Digital impressions mean no messy molds -- just faster, more accurate results for crowns, bridges, and implants at our Albemarle and Charlotte offices.</p>
          </div>
        </div>
        <div class="flex items-start gap-3 p-4 bg-white rounded-xl border border-border">
          <svg class="w-5 h-5 text-primary mt-0.5 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" /></svg>
          <div>
            <span class="font-medium text-text">Experienced, Caring Dental Team</span>
            <p class="text-sm text-text-light mt-1">Our dentists bring years of specialized training in restorative procedures. From simple composite fillings to complex full mouth reconstructions, we approach every case with attention to detail and genuine concern for your comfort throughout the process.</p>
          </div>
        </div>
        <div class="flex items-start gap-3 p-4 bg-white rounded-xl border border-border">
          <svg class="w-5 h-5 text-primary mt-0.5 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" /></svg>
          <div>
            <span class="font-medium text-text">Premium Materials for Lasting Results</span>
            <p class="text-sm text-text-light mt-1">We select only the highest-quality materials -- BPA-free composite resins, medical-grade titanium implants, and porcelain crowns crafted by trusted dental labs. Every restoration is designed to look natural, feel comfortable, and last for years.</p>
          </div>
        </div>
        <div class="flex items-start gap-3 p-4 bg-white rounded-xl border border-border">
          <svg class="w-5 h-5 text-primary mt-0.5 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" /></svg>
          <div>
            <span class="font-medium text-text">Two Convenient Locations Serving the Greater Charlotte Area</span>
            <p class="text-sm text-text-light mt-1">Whether you live in Albemarle, Charlotte, Locust, Oakboro, Norwood, or anywhere in between, our two offices make it easy to receive high-quality restorative dental care close to home. We offer flexible scheduling Monday through Thursday to accommodate your busy life.</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- What to Expect -->
  <section class="py-16 lg:py-20 bg-white">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
      <h2 class="font-heading text-2xl sm:text-3xl font-bold text-text mb-6">What to Expect During Your Restorative Dentistry Visit</h2>
      <p class="text-text-light leading-relaxed mb-4">
        Understanding what happens during a restorative dental procedure can help ease any anxiety and prepare you for a smooth experience. While each treatment varies in complexity, most restorative procedures at Premier Dental follow a similar pattern designed to maximize your comfort and deliver excellent outcomes.
      </p>
      <div class="space-y-6 mt-8">
        <div class="flex gap-4 items-start">
          <span class="w-8 h-8 bg-primary text-white rounded-full flex items-center justify-center text-sm font-bold shrink-0">1</span>
          <div>
            <h3 class="font-heading text-lg font-semibold text-text mb-1">Comprehensive Examination and Diagnosis</h3>
            <p class="text-text-light leading-relaxed">Your visit begins with a thorough examination, including digital X-rays and an intraoral assessment. We evaluate the extent of damage or decay, discuss your symptoms, and explain all available treatment options. For patients visiting our Albemarle or Charlotte location for the first time, we also review your complete dental and medical history to ensure the safest approach.</p>
          </div>
        </div>
        <div class="flex gap-4 items-start">
          <span class="w-8 h-8 bg-primary text-white rounded-full flex items-center justify-center text-sm font-bold shrink-0">2</span>
          <div>
            <h3 class="font-heading text-lg font-semibold text-text mb-1">Treatment Planning and Discussion</h3>
            <p class="text-text-light leading-relaxed">Once we have a complete picture of your dental health, our team creates a personalized treatment plan. We explain the recommended procedure in detail -- whether it is a filling, crown, bridge, implant, or more complex reconstruction -- including estimated timelines, costs, and what to expect during recovery. You always have the final say in your treatment decisions.</p>
          </div>
        </div>
        <div class="flex gap-4 items-start">
          <span class="w-8 h-8 bg-primary text-white rounded-full flex items-center justify-center text-sm font-bold shrink-0">3</span>
          <div>
            <h3 class="font-heading text-lg font-semibold text-text mb-1">The Restorative Procedure</h3>
            <p class="text-text-light leading-relaxed">Most restorative treatments are performed with local anesthesia to ensure you remain comfortable throughout. Simple fillings typically take 30 to 60 minutes, while crowns and bridges may require one or two visits. Dental implants involve a surgical placement followed by a healing period of several months before the final restoration is attached. Throughout every step, our team prioritizes your comfort and keeps you informed.</p>
          </div>
        </div>
        <div class="flex gap-4 items-start">
          <span class="w-8 h-8 bg-primary text-white rounded-full flex items-center justify-center text-sm font-bold shrink-0">4</span>
          <div>
            <h3 class="font-heading text-lg font-semibold text-text mb-1">Recovery and Aftercare</h3>
            <p class="text-text-light leading-relaxed">After your procedure, we provide detailed aftercare instructions tailored to your specific treatment. For fillings, you can typically resume normal activities immediately. Crowns and bridges may cause mild sensitivity for a few days. Implant patients should follow a soft diet during the initial healing phase. We schedule follow-up appointments to monitor your progress and ensure your restoration is functioning perfectly. Consistent brushing, flossing, and regular checkups at Premier Dental will help your restorations last a lifetime.</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Restorative Dentistry FAQ -->
  <section class="py-16 lg:py-20 bg-bg-alt">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
      <h2 class="font-heading text-2xl sm:text-3xl font-bold text-text mb-8 text-center">Frequently Asked Questions About Restorative Dentistry</h2>
      <div class="space-y-3">
        <details class="group bg-white rounded-xl border border-border overflow-hidden hover:border-primary/30 transition-colors">
          <summary class="flex items-center justify-between cursor-pointer px-6 py-5 text-left">
            <span class="font-medium text-text pr-4">How long do dental crowns last?</span>
            <svg class="w-5 h-5 text-text-light shrink-0 transition-transform group-open:rotate-180" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/></svg>
          </summary>
          <div class="px-6 pb-5 text-text-light leading-relaxed">With proper care, dental crowns typically last 10 to 15 years, and many patients enjoy their crowns for 20 years or more. The longevity depends on the material used (porcelain, zirconia, or porcelain-fused-to-metal), your oral hygiene habits, and whether you grind your teeth. At Premier Dental in Albemarle and Charlotte, NC, we use high-quality crown materials and precise fitting techniques to maximize the lifespan of every restoration.</div>
        </details>
        <details class="group bg-white rounded-xl border border-border overflow-hidden hover:border-primary/30 transition-colors">
          <summary class="flex items-center justify-between cursor-pointer px-6 py-5 text-left">
            <span class="font-medium text-text pr-4">Is a root canal painful?</span>
            <svg class="w-5 h-5 text-text-light shrink-0 transition-transform group-open:rotate-180" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/></svg>
          </summary>
          <div class="px-6 pb-5 text-text-light leading-relaxed">Modern root canal therapy is far less uncomfortable than most people expect. With today's anesthesia and advanced techniques, the procedure feels similar to getting a standard filling. Most patients report that the toothache or infection that brought them in was far more painful than the root canal itself. After the procedure, mild soreness is normal for a few days but can be managed with over-the-counter pain medication. Learn more about our approach in our <a href="/blog/root-canal-therapy-in-charlotte" class="text-primary hover:underline">root canal therapy guide</a>.</div>
        </details>
        <details class="group bg-white rounded-xl border border-border overflow-hidden hover:border-primary/30 transition-colors">
          <summary class="flex items-center justify-between cursor-pointer px-6 py-5 text-left">
            <span class="font-medium text-text pr-4">What is the difference between a dental bridge and a dental implant?</span>
            <svg class="w-5 h-5 text-text-light shrink-0 transition-transform group-open:rotate-180" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/></svg>
          </summary>
          <div class="px-6 pb-5 text-text-light leading-relaxed">A dental bridge replaces missing teeth by anchoring artificial teeth to the natural teeth on either side of the gap. It does not require surgery but does require modifying the adjacent teeth. A dental implant, on the other hand, is a titanium post surgically placed in the jawbone that acts as an artificial root, supporting a crown independently without affecting neighboring teeth. Implants also help preserve jawbone density. During your consultation at our Albemarle or Charlotte office, our team will help determine which option is best for your specific situation. Read more about <a href="/blog/dental-bridges-in-charlotte" class="text-primary hover:underline">dental bridges</a> and <a href="/blog/dental-implants-in-charlotte" class="text-primary hover:underline">dental implants</a> on our blog.</div>
        </details>
        <details class="group bg-white rounded-xl border border-border overflow-hidden hover:border-primary/30 transition-colors">
          <summary class="flex items-center justify-between cursor-pointer px-6 py-5 text-left">
            <span class="font-medium text-text pr-4">How do I know if I need a filling or a crown?</span>
            <svg class="w-5 h-5 text-text-light shrink-0 transition-transform group-open:rotate-180" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/></svg>
          </summary>
          <div class="px-6 pb-5 text-text-light leading-relaxed">The choice between a filling and a crown depends on the extent of damage to the tooth. Fillings are ideal for small to moderate cavities where plenty of healthy tooth structure remains. When decay or damage is more extensive -- affecting a large portion of the tooth or compromising its structural integrity -- a crown provides the full coverage and strength needed to protect the tooth long-term. In some cases, an <a href="/blog/inlays-and-onlays-in-charlotte" class="text-primary hover:underline">inlay or onlay</a> may be the perfect middle ground. Our dentists will evaluate your tooth with digital imaging and recommend the most conservative, effective solution.</div>
        </details>
        <details class="group bg-white rounded-xl border border-border overflow-hidden hover:border-primary/30 transition-colors">
          <summary class="flex items-center justify-between cursor-pointer px-6 py-5 text-left">
            <span class="font-medium text-text pr-4">Can old metal fillings be replaced with tooth-colored ones?</span>
            <svg class="w-5 h-5 text-text-light shrink-0 transition-transform group-open:rotate-180" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/></svg>
          </summary>
          <div class="px-6 pb-5 text-text-light leading-relaxed">Yes, old amalgam (metal) fillings can be safely removed and replaced with modern composite resin fillings that match the natural color of your teeth. Many patients choose to replace metal fillings for aesthetic reasons, and it can also be beneficial if the old filling is cracked, worn, or leaking. At Premier Dental, we use BPA-free composite materials for a durable, natural-looking result. Visit our <a href="/blog/dental-fillings-in-charlotte" class="text-primary hover:underline">dental fillings guide</a> for more information.</div>
