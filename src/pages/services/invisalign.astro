---
import ServiceLayout from '../../layouts/ServiceLayout.astro';

const benefits = [
  { title: 'Nearly Invisible', desc: 'Clear aligners are virtually undetectable, so you can smile confidently throughout treatment.' },
  { title: 'Removable', desc: 'Take them out to eat, drink, brush, and floss -- no food restrictions and easy oral hygiene.' },
  { title: 'Comfortable', desc: 'Smooth plastic aligners with no metal brackets or wires that irritate your cheeks and gums.' },
  { title: 'Predictable Results', desc: 'Advanced 3D imaging maps your entire treatment plan from start to finish before you begin.' },
  { title: 'Fewer Office Visits', desc: 'Aligner changes happen at home, so you spend less time in the dental chair.' },
  { title: 'Treats Many Issues', desc: 'Corrects crowding, spacing, overbite, underbite, crossbite, and open bite effectively.' },
];

const steps = [
  { num: '1', title: 'Consultation', desc: 'We assess your teeth and determine if Invisalign is right for you. Digital scans create a precise 3D model of your smile.' },
  { num: '2', title: 'Custom Treatment Plan', desc: 'Using advanced software, we map out the exact movements of your teeth and show you a preview of your final results.' },
  { num: '3', title: 'Receive Your Aligners', desc: 'Your custom aligners are manufactured and delivered. Wear each set for about 2 weeks, 20-22 hours per day.' },
  { num: '4', title: 'Enjoy Your New Smile', desc: "After completing your aligner series, you'll have the straight, beautiful smile you've always wanted. A retainer keeps results lasting." },
];

const schema = {
  "@context": "https://schema.org",
  "@type": "MedicalWebPage",
  "name": "Invisalign | Premier Dental | Clear Aligners in Albemarle & Charlotte, NC",
  "description": "Invisalign clear aligners at Premier Dental. Straighten your teeth discreetly and comfortably without metal brackets. Available in Albemarle and Charlotte, NC.",
  "mainEntity": {
    "@type": "MedicalProcedure",
    "name": "Invisalign Clear Aligners",
    "procedureType": "http://schema.org/NoninvasiveProcedure"
  }
};
---

<ServiceLayout
  title="Invisalign | Premier Dental | Clear Aligners in Albemarle & Charlotte, NC"
  description="Invisalign clear aligners at Premier Dental. Straighten your teeth discreetly and comfortably without metal brackets. Available in Albemarle and Charlotte, NC."
  keywords="Invisalign Albemarle NC, Invisalign Charlotte NC, clear aligners, teeth straightening, orthodontics, invisible braces"
  schema={schema}
>
  <!-- Hero -->
  <section class="relative bg-bg-alt py-20 lg:py-28">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid lg:grid-cols-2 gap-12 items-center">
        <div>
          <a href="/#services" class="inline-flex items-center gap-1.5 text-sm font-medium text-primary hover:underline mb-6">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"/></svg>
            Back to Services
          </a>
          <h1 class="font-heading text-4xl sm:text-5xl lg:text-6xl font-bold text-text">Invisalign Clear Aligners</h1>
          <p class="mt-6 text-lg text-text-light leading-relaxed">
            Invisalign is a method of braces that does not use brackets and elastic bands like conventional braces but uses transparent aligners to straighten teeth.
          </p>
          <ul class="mt-4 space-y-2 text-text-light text-sm">
            <li class="flex items-start gap-2"><span class="text-primary mt-0.5">&#10003;</span> Almost invisible — smile confidently throughout treatment</li>
            <li class="flex items-start gap-2"><span class="text-primary mt-0.5">&#10003;</span> Easy to put on and take off — enjoy your favorite food anytime</li>
            <li class="flex items-start gap-2"><span class="text-primary mt-0.5">&#10003;</span> Teeth move slowly and gently, reducing pain during treatment</li>
            <li class="flex items-start gap-2"><span class="text-primary mt-0.5">&#10003;</span> Comfortable schedule with visits every 6–8 weeks</li>
            <li class="flex items-start gap-2"><span class="text-primary mt-0.5">&#10003;</span> Removable — brush and floss as you normally would</li>
            <li class="flex items-start gap-2"><span class="text-primary mt-0.5">&#10003;</span> Visualize your treatment timeline with a detailed view</li>
          </ul>
          <div class="mt-8 space-y-5">
            <div class="flex flex-col sm:flex-row gap-3">
              <a href="tel:7049825516" class="inline-flex items-center justify-center gap-2 px-6 py-3.5 bg-white text-primary font-semibold rounded-full border-2 border-primary/20 hover:border-primary hover:bg-primary/5 transition-colors shadow-md">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/></svg>
                Albemarle (704) 982-5516
              </a>
              <a href="tel:7046887120" class="inline-flex items-center justify-center gap-2 px-6 py-3.5 bg-white text-primary font-semibold rounded-full border-2 border-primary/20 hover:border-primary hover:bg-primary/5 transition-colors shadow-md">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/></svg>
                Charlotte (704) 688-7120
              </a>
            </div>
            <a href="/#contact" class="inline-flex items-center justify-center gap-2 px-6 py-3.5 bg-primary text-white font-semibold rounded-full hover:bg-primary-dark transition-colors shadow-lg shadow-primary/20">
              Schedule a Consultation
            </a>
          </div>
        </div>
        <div class="rounded-2xl overflow-hidden shadow-2xl">
          <img src="/wp-content/uploads/2024/12/5.jpg" alt="Invisalign clear aligners at Premier Dental" width="600" height="400" class="w-full h-auto object-cover" loading="eager" />
        </div>
      </div>
    </div>
  </section>

  <!-- What is Invisalign -->
  <section class="py-20 bg-white">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
      <h2 class="font-heading text-3xl sm:text-4xl font-bold text-text mb-6">What is Invisalign?</h2>
      <p class="text-text-light leading-relaxed">
        Invisalign uses a series of custom-made, clear plastic aligners to gradually shift your teeth into their ideal positions. Each set of aligners is worn for about two weeks before moving to the next set in the series. The result? A straighter, more beautiful smile -- without the look and feel of traditional metal braces.
      </p>
      <p class="text-text-light leading-relaxed mt-4">
        Invisalign can correct a wide range of alignment issues including crowding, spacing, overbite, underbite, crossbite, and open bite. It's a popular choice for both adults and teens who want a discreet and comfortable orthodontic solution.
      </p>
    </div>
  </section>

  <!-- Why Choose Invisalign -->
  <section class="py-20 bg-bg-alt">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <h2 class="font-heading text-3xl sm:text-4xl font-bold text-text text-center mb-12">Why Choose Invisalign?</h2>
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
        {benefits.map((b) => (
          <div class="bg-white rounded-2xl p-6 border border-border hover:border-primary/30 hover:shadow-lg transition-all">
            <h3 class="font-heading text-lg font-semibold text-text mb-2">{b.title}</h3>
            <p class="text-sm text-text-light leading-relaxed">{b.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- How It Works -->
  <section class="py-20 bg-white">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
      <h2 class="font-heading text-3xl sm:text-4xl font-bold text-text text-center mb-12">How It Works</h2>
      <div class="space-y-8">
        {steps.map((step) => (
          <div class="flex gap-6 items-start">
            <div class="w-12 h-12 bg-primary text-white rounded-full flex items-center justify-center font-bold text-lg shrink-0 font-heading">
              {step.num}
            </div>
            <div>
              <h3 class="font-heading text-xl font-semibold text-text mb-2">{step.title}</h3>
              <p class="text-text-light leading-relaxed">{step.desc}</p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Why Choose Premier Dental for Invisalign -->
  <section class="py-16 lg:py-20 bg-bg-alt">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
      <h2 class="font-heading text-2xl sm:text-3xl font-bold text-text mb-6">Why Choose Premier Dental for Invisalign in Albemarle and Charlotte, NC</h2>
      <p class="text-text-light leading-relaxed mb-6">
        Choosing the right Invisalign provider is just as important as the treatment itself. At Premier Dental, we have helped patients throughout Albemarle, Charlotte, Stanly County, and the greater Mecklenburg County area achieve beautifully straight smiles with Invisalign clear aligners. Here is why our patients trust us with their orthodontic care.
      </p>
      <div class="space-y-4">
        <div class="flex items-start gap-3 p-4 bg-white rounded-xl border border-border">
          <svg class="w-5 h-5 text-primary mt-0.5 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" /></svg>
          <div>
            <span class="font-medium text-text">Experienced Invisalign Providers</span>
            <p class="text-sm text-text-light mt-1">Our dentists have completed advanced Invisalign training and have successfully treated a wide range of alignment cases -- from mild crowding to complex bite corrections. Our experience means more predictable results and a smoother treatment journey for you.</p>
          </div>
        </div>
        <div class="flex items-start gap-3 p-4 bg-white rounded-xl border border-border">
          <svg class="w-5 h-5 text-primary mt-0.5 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" /></svg>
          <div>
            <span class="font-medium text-text">Digital Smile Preview Technology</span>
            <p class="text-sm text-text-light mt-1">Using the iTero digital scanner, we create a precise 3D model of your teeth and show you a virtual preview of your final results before treatment even begins. No messy impressions -- just accurate, comfortable digital scans that allow you to see your future smile.</p>
          </div>
        </div>
        <div class="flex items-start gap-3 p-4 bg-white rounded-xl border border-border">
          <svg class="w-5 h-5 text-primary mt-0.5 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" /></svg>
          <div>
            <span class="font-medium text-text">Treatment for Teens and Adults</span>
            <p class="text-sm text-text-light mt-1">Whether you are a teenager who wants a discreet alternative to metal braces or an adult who has always wanted straighter teeth, Invisalign is an excellent option. We offer both Invisalign and Invisalign Teen at our Albemarle and Charlotte offices, each tailored to the unique needs of the patient.</p>
          </div>
        </div>
        <div class="flex items-start gap-3 p-4 bg-white rounded-xl border border-border">
          <svg class="w-5 h-5 text-primary mt-0.5 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" /></svg>
          <div>
            <span class="font-medium text-text">Comprehensive Orthodontic and Dental Care</span>
            <p class="text-sm text-text-light mt-1">Unlike standalone orthodontic offices, Premier Dental offers complete dental care alongside Invisalign. If you need a cleaning, whitening, or any other dental treatment during your Invisalign journey, we handle it all in-house -- no need to visit multiple providers.</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- What to Expect -->
  <section class="py-16 lg:py-20 bg-white">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
      <h2 class="font-heading text-2xl sm:text-3xl font-bold text-text mb-6">What to Expect During Invisalign Treatment</h2>
      <p class="text-text-light leading-relaxed mb-4">
        Invisalign treatment at Premier Dental is designed to fit seamlessly into your lifestyle. Most treatment plans span 6 to 18 months, depending on the complexity of your case. Here is a closer look at what the experience is like from start to finish.
      </p>
      <div class="space-y-6 mt-8">
        <div class="flex gap-4 items-start">
          <span class="w-8 h-8 bg-primary text-white rounded-full flex items-center justify-center text-sm font-bold shrink-0">1</span>
          <div>
            <h3 class="font-heading text-lg font-semibold text-text mb-1">Wearing Your Aligners</h3>
            <p class="text-text-light leading-relaxed">Each set of custom aligners should be worn for 20 to 22 hours per day, removing them only for eating, drinking (anything other than water), brushing, and flossing. You will switch to a new set of aligners approximately every 1 to 2 weeks as your teeth gradually shift into their target positions. Most patients adjust to wearing aligners within the first day or two.</p>
          </div>
        </div>
        <div class="flex gap-4 items-start">
          <span class="w-8 h-8 bg-primary text-white rounded-full flex items-center justify-center text-sm font-bold shrink-0">2</span>
          <div>
            <h3 class="font-heading text-lg font-semibold text-text mb-1">Progress Checkups</h3>
            <p class="text-text-light leading-relaxed">You will visit our Albemarle or Charlotte office approximately every 6 to 8 weeks so we can monitor your progress, make any necessary adjustments, and provide your next sets of aligners. These appointments are typically quick -- often 15 to 20 minutes -- and do not require the tightening or adjustments associated with traditional braces.</p>
          </div>
        </div>
        <div class="flex gap-4 items-start">
          <span class="w-8 h-8 bg-primary text-white rounded-full flex items-center justify-center text-sm font-bold shrink-0">3</span>
          <div>
            <h3 class="font-heading text-lg font-semibold text-text mb-1">Mild Discomfort is Normal</h3>
            <p class="text-text-light leading-relaxed">When you switch to a new set of aligners, you may experience mild pressure or tightness for the first day or two. This is completely normal and indicates that your teeth are moving as planned. The discomfort is typically much less than what patients experience with traditional braces and can usually be managed with over-the-counter pain relief if needed.</p>
          </div>
        </div>
        <div class="flex gap-4 items-start">
          <span class="w-8 h-8 bg-primary text-white rounded-full flex items-center justify-center text-sm font-bold shrink-0">4</span>
          <div>
            <h3 class="font-heading text-lg font-semibold text-text mb-1">Retention Phase</h3>
            <p class="text-text-light leading-relaxed">After completing your aligner series, you will wear a retainer to maintain your new smile. Retainers are essential for preventing teeth from shifting back to their original positions. We typically recommend wearing your retainer full-time for the first few months, then transitioning to nighttime-only wear. Learn more about <a href="/blog/invisalign-aftercare-and-retainers" class="text-primary hover:underline">Invisalign aftercare and retainers</a>.</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Invisalign FAQ -->
  <section class="py-16 lg:py-20 bg-bg-alt">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
      <h2 class="font-heading text-2xl sm:text-3xl font-bold text-text mb-8 text-center">Frequently Asked Questions About Invisalign</h2>
      <div class="space-y-3">
        <details class="group bg-white rounded-xl border border-border overflow-hidden hover:border-primary/30 transition-colors">
          <summary class="flex items-center justify-between cursor-pointer px-6 py-5 text-left">
            <span class="font-medium text-text pr-4">How long does Invisalign treatment take?</span>
            <svg class="w-5 h-5 text-text-light shrink-0 transition-transform group-open:rotate-180" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/></svg>
          </summary>
          <div class="px-6 pb-5 text-text-light leading-relaxed">Treatment duration varies depending on the complexity of your case. Mild crowding or spacing issues may be resolved in as few as 6 months, while more complex alignment or bite corrections can take 12 to 18 months. During your initial consultation at our Albemarle or Charlotte office, we will provide an estimated timeline based on your specific treatment plan. Learn more about the <a href="/blog/invisalign-process-in-charlotte" class="text-primary hover:underline">Invisalign process</a>.</div>
        </details>
        <details class="group bg-white rounded-xl border border-border overflow-hidden hover:border-primary/30 transition-colors">
          <summary class="flex items-center justify-between cursor-pointer px-6 py-5 text-left">
            <span class="font-medium text-text pr-4">Is Invisalign as effective as traditional braces?</span>
            <svg class="w-5 h-5 text-text-light shrink-0 transition-transform group-open:rotate-180" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/></svg>
          </summary>
          <div class="px-6 pb-5 text-text-light leading-relaxed">For many cases, Invisalign is just as effective as traditional braces. It can treat crowding, spacing, overbite, underbite, crossbite, and open bite. However, some very complex orthodontic cases may still require traditional braces. During your consultation, our team will assess your specific needs and honestly recommend the best option for your situation. Read our detailed comparison of <a href="/blog/invisalign-vs-traditional-braces" class="text-primary hover:underline">Invisalign vs. traditional braces</a>.</div>
        </details>
        <details class="group bg-white rounded-xl border border-border overflow-hidden hover:border-primary/30 transition-colors">
          <summary class="flex items-center justify-between cursor-pointer px-6 py-5 text-left">
            <span class="font-medium text-text pr-4">Can teenagers use Invisalign?</span>
            <svg class="w-5 h-5 text-text-light shrink-0 transition-transform group-open:rotate-180" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/></svg>
          </summary>
          <div class="px-6 pb-5 text-text-light leading-relaxed">Yes. Invisalign Teen is specifically designed for teenage patients. It includes features like compliance indicators (blue dots that fade with wear to help parents and dentists verify the aligners are being worn enough) and extra replacement aligners in case any are lost. Most teens appreciate that Invisalign is nearly invisible and does not affect their ability to play sports or musical instruments. Explore our guide on <a href="/blog/invisalign-for-different-age-groups" class="text-primary hover:underline">Invisalign for different age groups</a>.</div>
        </details>
        <details class="group bg-white rounded-xl border border-border overflow-hidden hover:border-primary/30 transition-colors">
          <summary class="flex items-center justify-between cursor-pointer px-6 py-5 text-left">
            <span class="font-medium text-text pr-4">How much does Invisalign cost in the Charlotte and Albemarle, NC area?</span>
            <svg class="w-5 h-5 text-text-light shrink-0 transition-transform group-open:rotate-180" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/></svg>
          </summary>
          <div class="px-6 pb-5 text-text-light leading-relaxed">Invisalign costs in the Charlotte and Albemarle area typically range from $3,000 to $7,000, depending on the complexity and length of treatment. This is often comparable to the cost of traditional braces. Many dental insurance plans now include orthodontic benefits that can be applied to Invisalign, and we offer flexible payment plans to make treatment affordable. During your consultation, we provide a detailed cost estimate tailored to your specific case. Read more about <a href="/blog/invisalign-costs-and-financing-options" class="text-primary hover:underline">Invisalign costs and financing</a>.</div>
        </details>
        <details class="group bg-white rounded-xl border border-border overflow-hidden hover:border-primary/30 transition-colors">
          <summary class="flex items-center justify-between cursor-pointer px-6 py-5 text-left">
            <span class="font-medium text-text pr-4">How do I care for my Invisalign aligners?</span>
            <svg class="w-5 h-5 text-text-light shrink-0 transition-transform group-open:rotate-180" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/></svg>
          </summary>
          <div class="px-6 pb-5 text-text-light leading-relaxed">Caring for your aligners is straightforward. Rinse them every time you remove them, clean them daily with a soft toothbrush and clear liquid soap (not toothpaste, which can scratch them), and store them in their case when not in use. Avoid eating or drinking anything other than water while wearing them, and always brush your teeth before putting aligners back in to prevent bacteria buildup. For comprehensive tips, visit our <a href="/blog/invisalign-care-and-maintenance" class="text-primary hover:underline">Invisalign care and maintenance guide</a>.</div>
        </details>
      </div>
    </div>
  </section>

  <!-- Insurance and Pricing -->
  <section class="py-16 lg:py-20 bg-white">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
      <h2 class="font-heading text-2xl sm:text-3xl font-bold text-text mb-6">Invisalign Insurance and Financing Options</h2>
      <p class="text-text-light leading-relaxed mb-4">
        Many dental insurance plans include orthodontic benefits that can be applied toward the cost of Invisalign treatment. At Premier Dental, our team will review your insurance benefits and help you understand your coverage before treatment begins. We work with most major dental insurance providers at both our Albemarle and Charlotte locations.
      </p>
      <p class="text-text-light leading-relaxed mb-4">
        For patients without orthodontic coverage or those who need help managing out-of-pocket costs, we offer flexible payment plans and financing options. We believe that a straight, healthy smile should be accessible to everyone, and we will work with you to find a financial arrangement that fits your budget.
      </p>
      <p class="text-text-light leading-relaxed">
        Contact our Albemarle office at <a href="tel:7049825516" class="text-primary font-semibold hover:underline">(704) 982-5516</a> or our Charlotte office at <a href="tel:7046887120" class="text-primary font-semibold hover:underline">(704) 688-7120</a> to schedule your free Invisalign consultation and get a personalized cost estimate.
      </p>
    </div>
  </section>

  <!-- Related Resources -->
  <section class="py-16 lg:py-20 bg-bg-alt">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
      <h2 class="font-heading text-2xl sm:text-3xl font-bold text-text mb-6">Invisalign Resources and Related Services</h2>
      <p class="text-text-light leading-relaxed mb-6">
        Explore our comprehensive Invisalign guides and related dental services to learn everything you need to know about clear aligner treatment.
      </p>
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
        <a href="/blog/overview-of-invisalign-in-charlotte" class="flex items-center gap-3 p-4 bg-white rounded-xl border border-border hover:border-primary/30 hover:shadow-md transition-all">
          <svg class="w-5 h-5 text-primary shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/></svg>
          <span class="text-text font-medium text-sm">Complete Overview of Invisalign in Charlotte</span>
        </a>
        <a href="/blog/invisalign-vs-traditional-braces" class="flex items-center gap-3 p-4 bg-white rounded-xl border border-border hover:border-primary/30 hover:shadow-md transition-all">
          <svg class="w-5 h-5 text-primary shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/></svg>
          <span class="text-text font-medium text-sm">Invisalign vs. Traditional Braces</span>
