---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import { blogPosts } from '../../data/blogPosts';
import type { GetStaticPaths } from 'astro';

export const getStaticPaths: GetStaticPaths = async () => {
  return blogPosts.map(post => ({
    params: { slug: post.slug },
    props: { post },
  }));
};

const { post } = Astro.props;

// Strip the first <figure><img> if it matches the featured image (avoid duplication)
let articleContent = post.content || '';
articleContent = articleContent.replace(/^(\s*<figure><img[^>]*><\/figure>\s*)/, '');

// Find related posts (same category, excluding current)
const relatedPosts = blogPosts
  .filter(p => p.category === post.category && p.slug !== post.slug)
  .slice(0, 3);

const title = `${post.title} | Premier Dental Blog`;
const description = post.excerpt;

const blogSchema = {
  "@context": "https://schema.org",
  "@type": "BlogPosting",
  "headline": post.title,
  "description": post.excerpt,
  "image": `https://premierdentalnc.com${post.image}`,
  "datePublished": new Date(post.date).toISOString(),
  "dateModified": new Date(post.date).toISOString(),
  "author": {
    "@type": "Organization",
    "name": "Premier Dental",
    "url": "https://premierdentalnc.com"
  },
  "publisher": {
    "@type": "Organization",
    "name": "Premier Dental",
    "logo": {
      "@type": "ImageObject",
      "url": "https://premierdentalnc.com/wp-content/uploads/2024/08/logo-dental-premier-200x200.png.webp"
    }
  },
  "mainEntityOfPage": {
    "@type": "WebPage",
    "@id": `https://premierdentalnc.com/blog/${post.slug}`
  },
  "articleSection": post.category
};
---

<Layout title={title} description={description} keywords={`${post.category}, dental blog, Premier Dental, Charlotte NC`} schema={blogSchema}>
  <Header />
  <main class="pt-16 lg:pt-20">
    <!-- Article Header -->
    <section class="bg-gradient-to-br from-primary to-primary-dark py-12 sm:py-16">
      <div class="max-w-4xl mx-auto px-4 sm:px-6">
        <nav class="mb-6" aria-label="Breadcrumb">
          <ol class="flex items-center gap-2 text-sm text-white/60">
            <li><a href="/" class="hover:text-white transition-colors">Home</a></li>
            <li><span>/</span></li>
            <li><a href="/blog" class="hover:text-white transition-colors">Blog</a></li>
            <li><span>/</span></li>
            <li class="text-white/90 truncate max-w-[200px] sm:max-w-none">{post.title}</li>
          </ol>
        </nav>
        <span class="inline-block px-3 py-1 text-xs font-semibold rounded-full bg-white/20 text-white backdrop-blur-sm mb-4">
          {post.category}
        </span>
        <h1 class="font-heading text-2xl sm:text-3xl lg:text-4xl font-bold text-white mb-4 leading-tight">
          {post.title}
        </h1>
        <div class="flex items-center gap-4 text-white/70 text-sm">
          <time>{post.date}</time>
          <span class="w-1 h-1 rounded-full bg-white/40"></span>
          <span>Premier Dental Team</span>
        </div>
      </div>
    </section>

    <!-- Featured Image -->
    <section class="relative -mt-1">
      <div class="max-w-4xl mx-auto px-4 sm:px-6">
        <div class="rounded-2xl overflow-hidden shadow-xl -mt-4 sm:-mt-6">
          <img
            src={post.image}
            alt={post.title}
            class="w-full aspect-[16/9] object-cover"
            loading="eager"
          />
        </div>
      </div>
    </section>

    <!-- Article Content -->
    <section class="py-10 sm:py-14">
      <div class="max-w-4xl mx-auto px-4 sm:px-6">
        <div class="max-w-3xl mx-auto">
          <!-- Intro excerpt styled as a lead paragraph -->
          <div class="prose prose-lg max-w-none">
            <p class="text-lg sm:text-xl text-text-light leading-relaxed mb-8 font-medium">
              {post.excerpt}
            </p>
          </div>

          <!-- Full Article Content -->
          {articleContent && (
            <div class="article-content [&_h2]:font-heading [&_h2]:text-[#1a2b3c] [&_h2]:text-2xl [&_h2]:font-bold [&_h2]:mt-10 [&_h2]:mb-4 [&_h2]:border-b [&_h2]:border-border [&_h2]:pb-2 [&_h3]:font-heading [&_h3]:text-[#1a2b3c] [&_h3]:text-xl [&_h3]:font-bold [&_h3]:mt-8 [&_h3]:mb-3 [&_h4]:font-heading [&_h4]:text-[#1a2b3c] [&_h4]:text-lg [&_h4]:font-semibold [&_h4]:mt-6 [&_h4]:mb-2 [&_p]:text-text-light [&_p]:leading-relaxed [&_p]:mb-4 [&_li]:text-text-light [&_li]:leading-relaxed [&_strong]:text-[#1a2b3c] [&_strong]:font-semibold [&_img]:rounded-xl [&_img]:shadow-md [&_img]:my-6 [&_img]:max-w-md [&_img]:mx-auto [&_figure]:my-6 [&_figure]:text-center [&_table]:border-collapse [&_table]:w-full [&_table]:my-6 [&_th]:bg-primary/10 [&_th]:text-text [&_th]:font-semibold [&_th]:p-3 [&_th]:text-left [&_th]:border [&_th]:border-border [&_td]:p-3 [&_td]:border [&_td]:border-border [&_td]:text-text-light [&_a]:text-primary [&_a]:font-medium [&_a]:no-underline hover:[&_a]:underline [&_ul]:list-disc [&_ul]:pl-6 [&_ul]:mb-4 [&_ol]:list-decimal [&_ol]:pl-6 [&_ol]:mb-4"
              set:html={articleContent}
            />
          )}

          <!-- CTA inline -->
          <div class="bg-gradient-to-r from-primary/5 to-primary/10 border border-primary/20 rounded-2xl p-6 sm:p-8 my-8">
            <h3 class="font-heading text-xl font-semibold text-text mb-2">
              Have Questions About {post.category}?
            </h3>
            <p class="text-text-light mb-4">
              Our experienced team at Premier Dental is ready to help you with personalized care and expert guidance.
            </p>
            <div class="flex flex-col sm:flex-row gap-3">
              <a
                href="/#contact"
                class="inline-flex items-center justify-center gap-2 px-6 py-2.5 bg-primary text-white text-sm font-semibold rounded-full hover:bg-primary-dark transition-colors shadow-md shadow-primary/20"
              >
                Book a Consultation
              </a>
              <a
                href="tel:7049825516"
                class="inline-flex items-center justify-center gap-2 px-6 py-2.5 bg-white text-primary text-sm font-semibold rounded-full border border-primary/20 hover:border-primary hover:bg-primary/5 transition-colors shadow-sm"
              >
                <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/></svg>
                Albemarle (704) 982-5516
              </a>
              <a
                href="tel:7046887120"
                class="inline-flex items-center justify-center gap-2 px-6 py-2.5 bg-white text-primary text-sm font-semibold rounded-full border border-primary/20 hover:border-primary hover:bg-primary/5 transition-colors shadow-sm"
              >
                <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/></svg>
                Charlotte (704) 688-7120
              </a>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Related Posts -->
    {relatedPosts.length > 0 && (
      <section class="py-12 sm:py-16 bg-bg-alt border-t border-border">
        <div class="max-w-[1400px] mx-auto px-4 sm:px-6 xl:px-8">
          <h2 class="font-heading text-2xl sm:text-3xl font-bold text-text mb-8 text-center">
            Related Articles
          </h2>
          <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6 lg:gap-8">
            {relatedPosts.map((related) => (
              <article class="group bg-white rounded-2xl shadow-sm border border-border overflow-hidden hover:shadow-lg hover:-translate-y-1 transition-all duration-300">
                <a href={`/blog/${related.slug}`} class="block">
                  <div class="relative overflow-hidden aspect-[16/10]">
                    <img
                      src={related.image}
                      alt={related.title}
                      class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
                      loading="lazy"
                    />
                    <div class="absolute top-3 left-3">
                      <span class="inline-block px-3 py-1 text-xs font-semibold rounded-full bg-primary/90 text-white backdrop-blur-sm">
                        {related.category}
                      </span>
                    </div>
                  </div>
                  <div class="p-5 sm:p-6">
                    <time class="text-xs font-medium text-text-muted uppercase tracking-wide">
                      {related.date}
                    </time>
                    <h3 class="font-heading text-lg font-semibold text-text mt-2 mb-3 line-clamp-2 group-hover:text-primary transition-colors">
                      {related.title}
                    </h3>
                    <span class="inline-flex items-center text-sm font-semibold text-primary">
                      Read More
                      <svg class="w-4 h-4 ml-1 group-hover:translate-x-1 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
                      </svg>
                    </span>
                  </div>
                </a>
              </article>
            ))}
          </div>
        </div>
      </section>
    )}
  </main>
  <Footer />
</Layout>
