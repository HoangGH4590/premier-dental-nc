---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

const baseUrl = '/wp-content/uploads/2024/08';

const patients = [
  { id: 1, before: `${baseUrl}/1-800x1073.png.webp`, after: `${baseUrl}/2-800x1073.png.webp`, category: 'Cosmetic Dentistry', description: 'Complete smile restoration with cosmetic veneers and whitening treatment.' },
  { id: 2, before: `${baseUrl}/3-800x1073.png.webp`, after: `${baseUrl}/4-800x1073.png.webp`, category: 'Smile Makeover', description: 'Full smile makeover combining crowns, bonding, and teeth alignment.' },
  { id: 3, before: `${baseUrl}/5-800x1073.png.webp`, after: `${baseUrl}/6-800x1073.png.webp`, category: 'Restorative Dentistry', description: 'Restorative treatment addressing missing and damaged teeth for full function.' },
  { id: 4, before: `${baseUrl}/7-800x1073.png.webp`, after: `${baseUrl}/8-800x1073.png.webp`, category: 'Crowns & Veneers', description: 'Custom porcelain crowns and veneers for a natural, confident smile.' },
  { id: 5, before: `${baseUrl}/11-800x1073.png.webp`, after: `${baseUrl}/12-800x1073.png.webp`, category: 'Teeth Restoration', description: 'Comprehensive restoration of worn and discolored teeth.' },
  { id: 6, before: `${baseUrl}/13-800x1073.png.webp`, after: `${baseUrl}/14-800x1073.png.webp`, category: 'Smile Transformation', description: 'Dramatic smile transformation through advanced cosmetic procedures.' },
];

const schemaData = {
  "@context": "https://schema.org",
  "@type": "MedicalWebPage",
  "name": "Before & After Dental Transformations | Premier Dental",
  "description": "View real patient before and after photos from Premier Dental in Albemarle and Charlotte, NC. See results from cosmetic dentistry, smile makeovers, crowns, veneers, and restorative treatments.",
  "url": "https://premierdentalnc.com/our-work",
  "mainEntity": {
    "@type": "ItemList",
    "numberOfItems": patients.length,
    "itemListElement": patients.map((p, i) => ({
      "@type": "ListItem",
      "position": i + 1,
      "name": `Patient Case ${p.id} — ${p.category}`,
      "description": p.description
    }))
  },
  "isPartOf": {
    "@type": "WebSite",
    "name": "Premier Dental",
    "url": "https://premierdentalnc.com"
  }
};
---

<Layout
  title="Before & After Gallery | Premier Dental | Smile Transformations in Albemarle & Charlotte, NC"
  description="See real patient before and after photos from Premier Dental. Browse 7 smile transformations including cosmetic dentistry, veneers, crowns, restorative work, and full makeovers in Albemarle and Charlotte, NC."
  keywords="before and after dentist, smile makeover NC, cosmetic dentistry results, dental veneers before after, teeth restoration Albemarle, dental crowns Charlotte NC, Premier Dental transformations"
  schema={schemaData}
>
  <Header />
  <main class="pt-20 xl:pt-24">
    <!-- Hero -->
    <section class="py-14 lg:py-20 bg-bg-alt" aria-labelledby="our-work-heading">
      <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
        <p class="text-sm font-semibold text-primary uppercase tracking-wider mb-3">Our Work</p>
        <h1 id="our-work-heading" class="font-heading text-4xl sm:text-5xl lg:text-6xl font-bold text-text">
          Real Results. Real Smiles.
        </h1>
        <p class="mt-6 text-text-light leading-relaxed text-lg">
          Browse real before-and-after transformations from our patients. Drag the slider on each case to see the difference our cosmetic, restorative, and advanced dental care makes.
        </p>
      </div>
    </section>

    <!-- Gallery -->
    <section class="py-14 lg:py-20 bg-white" aria-label="Before and after patient gallery">
      <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-8">
          {patients.map((patient) => (
            <article class="ba-card group rounded-2xl overflow-hidden shadow-md hover:shadow-xl transition-shadow duration-300 border border-border bg-white">
              <!-- Before/After Slider -->
              <div
                class="ba-slider relative aspect-[3/4] overflow-hidden cursor-col-resize select-none"
                role="img"
                aria-label={`Before and after: ${patient.category} — ${patient.description}`}
              >
                <!-- After image (full, underneath) -->
                <img
                  src={patient.after}
                  alt={`After treatment: ${patient.category} patient at Premier Dental`}
                  width="800"
                  height="1073"
                  class="absolute inset-0 w-full h-full object-cover"
                  loading="lazy"
                  decoding="async"
                  draggable="false"
                />
                <!-- Before image (clipped overlay) -->
                <div class="ba-before absolute inset-0 overflow-hidden" style="clip-path: inset(0 50% 0 0);">
                  <img
                    src={patient.before}
                    alt={`Before treatment: ${patient.category} patient at Premier Dental`}
                    width="800"
                    height="1073"
                    class="absolute inset-0 w-full h-full object-cover"
                    loading="lazy"
                    decoding="async"
                    draggable="false"
                  />
                </div>
                <!-- Slider handle -->
                <div class="ba-handle absolute top-0 bottom-0 z-10 pointer-events-none" style="left: 50%; transform: translateX(-50%);">
                  <div class="w-0.5 h-full bg-white/90 shadow-md"></div>
                  <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-9 h-9 rounded-full bg-white shadow-lg flex items-center justify-center border-2 border-primary">
                    <svg class="w-4 h-4 text-primary" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M15 19l-7-7 7-7" />
                    </svg>
                    <svg class="w-4 h-4 text-primary -ml-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M9 5l7 7-7 7" />
                    </svg>
                  </div>
                </div>
                <!-- Labels -->
                <span class="absolute top-3 left-3 bg-black/60 backdrop-blur-sm text-white text-[11px] font-bold uppercase tracking-widest px-2.5 py-1 rounded-full pointer-events-none">Before</span>
                <span class="absolute top-3 right-3 bg-primary/80 backdrop-blur-sm text-white text-[11px] font-bold uppercase tracking-widest px-2.5 py-1 rounded-full pointer-events-none">After</span>
              </div>
            </article>
          ))}
        </div>

        <!-- CTA -->
        <div class="mt-16 text-center bg-bg-alt rounded-2xl p-10 lg:p-14 border border-border">
          <h2 class="font-heading text-2xl sm:text-3xl font-bold text-text">
            Ready for Your Transformation?
          </h2>
          <p class="mt-4 text-text-light max-w-2xl mx-auto leading-relaxed">
            Whether you need cosmetic work, restorative care, or a complete smile makeover — we're here to help you achieve the smile you've always wanted.
          </p>
          <div class="mt-8 flex flex-col sm:flex-row items-center justify-center gap-4">
            <a
              href="/#contact"
              class="inline-flex items-center px-8 py-3.5 bg-primary text-white font-semibold rounded-full hover:bg-primary-dark transition-colors shadow-lg shadow-primary/20"
            >
              Request an Appointment
            </a>
            <div class="flex items-center gap-4 text-sm text-text-light">
              <a href="tel:7049825516" class="hover:text-primary transition-colors">Albemarle: (704) 982-5516</a>
              <span class="text-border">|</span>
              <a href="tel:7046887120" class="hover:text-primary transition-colors">Charlotte: (704) 688-7120</a>
            </div>
          </div>
        </div>
      </div>
    </section>
  </main>
  <Footer />
</Layout>

<script>
  document.querySelectorAll('.ba-slider').forEach(slider => {
    const beforeLayer = slider.querySelector('.ba-before') as HTMLElement;
    const handle = slider.querySelector('.ba-handle') as HTMLElement;
    let isDragging = false;

    function updatePosition(clientX: number) {
      const rect = slider.getBoundingClientRect();
      let x = Math.max(0, Math.min(clientX - rect.left, rect.width));
      const pct = (x / rect.width) * 100;
      beforeLayer.style.clipPath = `inset(0 ${100 - pct}% 0 0)`;
      handle.style.left = `${pct}%`;
    }

    slider.addEventListener('mousedown', (e) => {
      isDragging = true;
      updatePosition((e as MouseEvent).clientX);
      e.preventDefault();
    });

    document.addEventListener('mousemove', (e) => {
      if (!isDragging) return;
      updatePosition(e.clientX);
    });

    document.addEventListener('mouseup', () => { isDragging = false; });

    slider.addEventListener('touchstart', (e) => {
      isDragging = true;
      updatePosition((e as TouchEvent).touches[0].clientX);
      e.preventDefault();
    }, { passive: false });

    document.addEventListener('touchmove', (e) => {
      if (!isDragging) return;
      updatePosition((e as TouchEvent).touches[0].clientX);
    });

    document.addEventListener('touchend', () => { isDragging = false; });
  });
</script>
